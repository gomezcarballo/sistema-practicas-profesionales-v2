<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorAsignacionProyecto">

    <children>

        <VBox fx:id="vbTarjetaAsignacionProyecto"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="15.0"
              styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloAsignarProyecto"
                       text="Asignar Proyecto"
                       styleClass="etiqueta-titulo"/>

                <Label fx:id="lblSubtituloProyectosSolicitados"
                       text="Proyectos solicitados por el practicante"
                       styleClass="etiqueta-campo"/>

                <Label fx:id="lblInstruccion"
                       text="Seleccione un proyecto para asignarlo al practicante"
                       styleClass="etiqueta-instruccion"/>

                <TableView fx:id="tblListaProyectos"
                           prefHeight="220.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="170.0"
                                     text="Nombre" />

                        <TableColumn fx:id="colNombreResponsable"
                                     prefWidth="170.0"
                                     text="Responsable" />

                        <TableColumn fx:id="colCupoMaximo"
                                     prefWidth="160.0"
                                     text="Cupo Máximo" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnAsignar"
                                mnemonicParsing="false"
                                onAction="#asignarProyecto"
                                prefWidth="140.0"
                                text="Asignar"
                                styleClass="boton-accion"/>

                        <Button fx:id="btnCancelar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                prefWidth="140.0"
                                text="Cancelar"
                                styleClass="boton-cancelar"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>