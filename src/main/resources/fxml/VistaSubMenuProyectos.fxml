               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="btnRegistrarProyecto" layoutX="209.0" layoutY="119.0" mnemonicParsing="false" onAction="#abrirRegistrarProyecto" prefHeight="56.0" prefWidth="153.0" text="Registrar Proyecto" />
            <Button fx:id="btnConsultarProyectos" layoutX="209.0" layoutY="194.0" mnemonicParsing="false" onAction="#abrirconsultarProyectos" prefHeight="56.0" prefWidth="153.0" text="Consultar Proyectos" />
            <Button fx:id="btnRegresar" layoutX="254.0" layoutY="315.0" mnemonicParsing="false" onAction="#regresar" text="Regresar" />
