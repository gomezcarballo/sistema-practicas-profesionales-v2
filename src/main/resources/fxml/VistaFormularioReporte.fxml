<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.practicante.ControladorFormularioReporte">
   <children>
      <Pane fx:id="pnlFormularioReporte" layoutX="23.0" layoutY="22.0" prefHeight="351.0" prefWidth="558.0">
         <children>
            <Label fx:id="lblTituloFormularioReporte" layoutX="190.0" layoutY="14.0" text="Formulario de Reporte">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <RadioButton fx:id="btnReporteMensual" layoutX="141.0" layoutY="51.0" mnemonicParsing="false" prefHeight="18.0" prefWidth="118.0" text="Reporte mensual">
               <toggleGroup>
                  <ToggleGroup fx:id="tgTipoReportes" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="btnReporteParcial" layoutX="296.0" layoutY="51.0" mnemonicParsing="false" text="Reporte parcial" toggleGroup="$tgTipoReportes"/>
            <AnchorPane layoutX="21.0" layoutY="80.0" prefHeight="256.0" prefWidth="519.0">
               <children>
                  <Label fx:id="lblPeriodoEscolar" layoutX="28.0" layoutY="47.0" text="Periodo escolar: " />
                  <Label fx:id="lblHorasCubiertas" layoutX="28.0" layoutY="88.0" text="Horas cubiertas" />
                  <Label fx:id="lblTiempoPlaneado" layoutX="25.0" layoutY="132.0" text="Tiempo planeado: " />
                  <Label fx:id="lblTiempoReal" layoutX="35.0" layoutY="177.0" text="Tiempo real: " />
                  <TextField fx:id="txtPeriodoEscolar" layoutX="130.0" layoutY="43.0" />
                  <TextField fx:id="txtHorasCubiertas" layoutX="130.0" layoutY="84.0" />
                  <TextField fx:id="txtTiempoPlaneado" layoutX="130.0" layoutY="128.0" />
                  <TextField fx:id="txtTiempoReal" layoutX="130.0" layoutY="173.0" />
                  <Label fx:id="lblFechaInicio" layoutX="300.0" layoutY="29.0" text="Fecha de inicio: " />
                  <DatePicker fx:id="dpFechaInicio" layoutX="297.0" layoutY="62.0" />
                  <Label fx:id="lblTiempoTermino" layoutX="300.0" layoutY="101.0" text="Fecha de termino: " />
                  <DatePicker fx:id="dpFechaTermino" layoutX="297.0" layoutY="132.0" />
                  <Button fx:id="btnGenerar" layoutX="190.0" layoutY="216.0" mnemonicParsing="false" onAction="#leerDatosDeReporte" text="Generar" />
                  <Button fx:id="btnRegresar" layoutX="271.0" layoutY="216.0" mnemonicParsing="false" onAction="#regresar" text="Regresar" />
               </children>
            </AnchorPane>
         </children>
      </Pane>
   </children>
</AnchorPane>
