<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.administrador.ControladorInicioSesionAdministrador">
   <children>
      <AnchorPane layoutX="34.0" layoutY="25.0" prefHeight="350.0" prefWidth="543.0">
         <children>
            <Label fx:id="tituloSPP" layoutX="126.0" layoutY="56.0" text="Sistema de Prácticas Profesionales">
               <font>
                  <Font name="Calibri" size="18.0" />
               </font>
            </Label>
            <Label fx:id="subtituloIniciarSesion" layoutX="219.0" layoutY="89.0" text="Iniciar sesión">
               <font>
                  <Font name="System Italic" size="14.0" />
               </font>
            </Label>
            <Label fx:id="textoCorreoMatricula" layoutX="50.0" layoutY="177.0" text="Correo institucional o matrícula:" />
            <Label fx:id="textoContrasena" layoutX="113.0" layoutY="223.0" text="Contraseña:" />
            <TextField fx:id="ingresaCorreoMatricula" layoutX="232.0" layoutY="173.0" prefHeight="26.0" prefWidth="230.0" promptText="Ej: zS24012345 o juan.uv.mx" />
            <PasswordField fx:id="ingresaContrasena" layoutX="232.0" layoutY="219.0" prefHeight="26.0" prefWidth="230.0" promptText="Ingrese contraseña" />
            <ButtonBar layoutX="109.0" layoutY="267.0" prefHeight="40.0" prefWidth="200.0" />
            <Button fx:id="botonIngresar" layoutX="200.0" layoutY="268.0" mnemonicParsing="false" onAction="#leerDatos" prefHeight="26.0" prefWidth="98.0" text="Ingresar" />
            <Label fx:id="instruccion" layoutX="170.0" layoutY="136.0" text="Ingrese los campos solicitados:" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
