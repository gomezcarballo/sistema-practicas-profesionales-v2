<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" 
      styleClass="panel-raiz" stylesheets="@../css/estilos.css" 
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="spp.presentacion.controladores.coordinador.ControladorListaReferenciaCurso">

    <children>

        <VBox fx:id="vbTarjetaNRC" alignment="CENTER" maxWidth="600.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label fx:id="lblTituloListaNRC" styleClass="etiqueta-titulo" text="Lista de NRCs" />
                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione un NRC para asignarle una nueva experiencia educativa" wrapText="true" />
                    </children>
                </VBox>

                <TableView fx:id="tblListaNRC" prefHeight="250.0" prefWidth="480.0" styleClass="tabla-estandar">
                    <columns>
                        <TableColumn fx:id="colNrc" prefWidth="538.0" text="NRC" />
                    </columns>
                </TableView>

                <BorderPane>
                    <left>
                        <HBox spacing="10.0" BorderPane.alignment="CENTER">
                            <children>
                                <Button fx:id="btnRegistrarEE" mnemonicParsing="false" onAction="#irARegistrarNuevaEE" styleClass="boton-accion" text="Registrar nueva EE" />
                                <Button fx:id="btnRegistrarNRC" mnemonicParsing="false" onAction="#irARegistrarNuevoNRC" styleClass="boton-accion" text="Registrar nuevo NRC" />
                            </children>
                        </HBox>
                    </left>

                    <right>
                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" styleClass="boton-cancelar" text="Regresar" BorderPane.alignment="CENTER" />
                    </right>
                </BorderPane>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>