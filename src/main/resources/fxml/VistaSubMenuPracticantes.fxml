            <Button fx:id="btnRegistrarPracticante" layoutX="192.0" layoutY="94.0" mnemonicParsing="false" onAction="#abrirRegistroPracticante" prefHeight="52.0" prefWidth="157.0" text="Registrar Practicante" />
