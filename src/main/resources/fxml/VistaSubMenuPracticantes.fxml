<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.menus.ControladorSubMenuPracticantes">

    <children>

        <VBox fx:id="vbTarjetaPracticantes"
              alignment="CENTER"
              maxWidth="450.0"
              spacing="18.0"
              styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloMenuPracticante"
                       text="Practicantes"
                       styleClass="etiqueta-titulo"/>

                <Label text="Seleccione una opción"
                       styleClass="etiqueta-instruccion"/>

                <Button fx:id="btnRegistrarPracticante"
                        mnemonicParsing="false"
                        onAction="#abrirRegistroPracticante"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Registrar Practicante"
                        styleClass="boton-accion"/>

                <Button fx:id="btnConsultarPracticantes"
                        mnemonicParsing="false"
                        onAction="#abrirConsultarPracticantes"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Consultar Practicantes"
                        styleClass="boton-accion"/>
                
                <Button fx:id="btnAsignarExperienciaEducativa"
                        mnemonicParsing="false"
                        onAction="#abrirListaPracticantesAsignacionEE"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Asignar Practicante a EE"
                        styleClass="boton-accion"/>

                <Button fx:id="btnRegresar"
                        mnemonicParsing="false"
                        onAction="#regresar"
                        prefWidth="140.0"
                        text="Regresar"
                        styleClass="boton-cancelar"/>

            </children>

            <padding>
                <Insets top="35.0"
                        right="35.0"
                        bottom="35.0"
                        left="35.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
