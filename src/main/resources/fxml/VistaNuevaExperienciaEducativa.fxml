<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="450.0" prefWidth="600.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorNuevaExperienciaEducativa">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets bottom="40.0" top="40.0" />
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaRegistro" alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="tarjeta-blanca">

                     <children>

                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label fx:id="lblTituloFormulario" styleClass="etiqueta-titulo" text="Nueva Experiencia Educativa" />

                              <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Ingrese los datos de la experiencia educativa:" />
                           </children>
                        </VBox>

                        <GridPane hgap="15.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="250.0" minWidth="10.0" prefWidth="220.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="270.0" />
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                           </rowConstraints>

                           <children>

                              <Label fx:id="lblNombre" styleClass="etiqueta-campo" text="Nombre:" GridPane.rowIndex="0" />
                              <TextField fx:id="txtNombre" maxWidth="1.7976931348623157E308" promptText="Ingrese el nombre" styleClass="campo-entrada" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label fx:id="lblPeriodo" styleClass="etiqueta-campo" text="Periodo:" GridPane.rowIndex="1" />
                              <ComboBox fx:id="cbPeriodo" maxWidth="1.7976931348623157E308" promptText="Seleccione el periodo" styleClass="campo-entrada" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label fx:id="lblCupo" styleClass="etiqueta-campo" text="Cupo:" GridPane.rowIndex="2" />
                              <TextField fx:id="txtCupo" maxWidth="1.7976931348623157E308" onKeyReleased="#validarCupo" promptText="Ingrese el cupo" styleClass="campo-entrada" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                           </children>
                        </GridPane>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnRegistrar" onAction="#leerDatosNuevaExperienciaEducativa" styleClass="boton-accion" text="Registrar" BorderPane.alignment="CENTER" />
                           </left>

                           <right>
                              <Button fx:id="btnCancelar" onAction="#regresar" styleClass="boton-cancelar" text="Cancelar" BorderPane.alignment="CENTER" />
                           </right>

                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>

                  </VBox>

               </children>
            </VBox>

         </content>
      </ScrollPane>

   </children>
</VBox>
