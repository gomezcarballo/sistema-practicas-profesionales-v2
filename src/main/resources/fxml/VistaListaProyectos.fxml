<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaProyectos">
   <children>
      <Label fx:id="lblTituloProyectos" layoutX="238.0" layoutY="41.0" text="TituloProyectos">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TableView fx:id="tblListaProyectos" layoutX="54.0" layoutY="106.0" prefHeight="233.0" prefWidth="506.0">
        <columns>
          <TableColumn fx:id="colNombre" prefWidth="141.5999755859375" text="Nombre" />
          <TableColumn fx:id="colDescripcion" minWidth="8.0" prefWidth="128.0" text="Descripción" />
            <TableColumn fx:id="colResponsable" prefWidth="128.79998779296875" text="Responsable" />
            <TableColumn fx:id="colCupoMaximo" prefWidth="107.19998779296873" text="Cupo Maximo" />
        </columns>
      </TableView>
      <Label layoutX="190.0" layoutY="78.0" text="Seleccione un proyecto para ver sus detalles" />
      <Button fx:id="btnVerDetalleProyecto" layoutX="175.0" layoutY="353.0" mnemonicParsing="false" onAction="#abrirDetalleProyecto" prefHeight="26.0" prefWidth="110.0" text="Ver detalle" />
      <Button fx:id="btnRegresar" layoutX="335.0" layoutY="354.0" mnemonicParsing="false" onAction="#regresar" prefHeight="26.0" prefWidth="123.0" text="Regresar" />
