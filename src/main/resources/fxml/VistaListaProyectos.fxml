<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaProyectos">

    <children>

        <VBox fx:id="vbTarjetaProyectos" alignment="CENTER" maxWidth="560.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloProyectos" styleClass="etiqueta-titulo" text="Proyectos" />

                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione un proyecto y escoja una acción" wrapText="true" />

                    </children>

                </VBox>

                <TableView fx:id="tblListaProyectos" prefHeight="230.0" prefWidth="500.0" styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre" prefWidth="170.0" reorderable="false" text="Nombre" />

                        <TableColumn fx:id="colResponsable" prefWidth="170.0" reorderable="false" text="Responsable" />

                        <TableColumn fx:id="colCupoMaximo" prefWidth="160.0" reorderable="false" text="Cupo máximo" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="10.0">

                    <children>

                        <Button fx:id="btnVerDetalleProyecto" mnemonicParsing="false" onAction="#abrirDetalleProyecto" styleClass="boton-accion" text="Ver detalle" />

                        <Button fx:id="btnActualizarProyecto" mnemonicParsing="false" onAction="#abrirActualizarProyecto" styleClass="boton-accion" text="Actualizar" />

                        <Button fx:id="btnInactivarProyecto" mnemonicParsing="false" onAction="#abrirInactivarProyecto" styleClass="boton-cancelar" text="Inactivar" />

                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" styleClass="boton-cancelar" text="Regresar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>