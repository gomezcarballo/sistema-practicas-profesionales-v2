<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="spp.presentacion.controladores.administrador.ControladorReactivacionProfesor">
   <children>
      <TableView fx:id="tblProfesoresInactivos" layoutX="45.0" layoutY="100.0" prefHeight="229.0" prefWidth="510.0">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="109.60003662109375" text="Nombre" />
            <TableColumn fx:id="colApellidoPaterno" prefWidth="129.60003662109375" text="Apellido Paterno" />
            <TableColumn fx:id="colApellidoMaterno" prefWidth="117.5999755859375" text="Apellido Materno" />
            <TableColumn fx:id="colCorreoInstitucional" prefWidth="152.00006103515625" text="CorreoInstitucional" />
         </columns>
      </TableView>
      <Button fx:id="btnCancelar" layoutX="318.0" layoutY="353.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
      <Button fx:id="btnReactivar" layoutX="223.0" layoutY="353.0" mnemonicParsing="false" onAction="#reactivarProfesor" text="Reactivar" />
