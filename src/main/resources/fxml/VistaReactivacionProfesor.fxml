<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" 
stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="spp.presentacion.controladores.administrador.ControladorReactivacionProfesor">

    <children>

        <VBox fx:id="vbTarjetaProfesoresInactivos" alignment="CENTER" maxWidth="560.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloProfesoresInactivos" styleClass="etiqueta-titulo" text="Profesores Inactivos" />

                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione un profesor para reactivarlo" wrapText="true" />

                    </children>

                </VBox>

                <TableView fx:id="tblProfesoresInactivos" prefHeight="230.0" prefWidth="500.0" styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre" prefWidth="108.80004739761353" reorderable="false" text="Nombre" />

                        <TableColumn fx:id="colApellidoPaterno" prefWidth="123.19995880126953" reorderable="false" text="Apellido paterno" />

                        <TableColumn fx:id="colApellidoMaterno" prefWidth="128.800048828125" reorderable="false" text="Apellido materno" />

                        <TableColumn fx:id="colCorreoInstitucional" prefWidth="140.7999267578125" reorderable="false" text="Correo institucional" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnReactivar" mnemonicParsing="false" onAction="#reactivarProfesor" styleClass="boton-accion" text="Reactivar" />

                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" styleClass="boton-cancelar" text="Cancelar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>
