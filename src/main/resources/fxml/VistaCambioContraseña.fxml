<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.perfilusuario.ControladorCambioContraseña">

   <children>

      <VBox fx:id="vbTarjetaCambioContrasena"
            alignment="CENTER"
            maxWidth="600.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <VBox alignment="CENTER" spacing="5.0">
               <children>

                  <Label fx:id="lblTituloNuevaContrasena"
                         text="Cambio de Contraseña"
                         styleClass="etiqueta-titulo" />

                  <Label fx:id="lblInstruccion"
                         text="Por favor, agregue una nueva contraseña segura de 10 caracteres"
                         styleClass="etiqueta-instruccion"
                         wrapText="true" />

               </children>
            </VBox>

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     hgrow="SOMETIMES"
                                     prefWidth="220.0" />

                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="280.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
               </rowConstraints>

               <children>

                  <Label fx:id="lblContrasenaActual"
                         text="Contraseña actual:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0" />

                  <PasswordField fx:id="pfContraseñaActual"
                                 promptText="Ingrese su contraseña actual"
                                 styleClass="campo-entrada"
                                 maxWidth="1.7976931348623157E308"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="0" />

                  <Label fx:id="lblNuevaContrasena"
                         text="Nueva contraseña:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1" />

                  <PasswordField fx:id="pfNuevaContraseña"
                                 promptText="Ingrese la nueva contraseña"
                                 styleClass="campo-entrada"
                                 maxWidth="1.7976931348623157E308"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="1" />

                  <Label fx:id="lblConfirmacionContrasena"
                         text="Confirmar contraseña:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2" />

                  <PasswordField fx:id="pfContraseñaConfirmada"
                                 promptText="Confirme la nueva contraseña"
                                 styleClass="campo-entrada"
                                 maxWidth="1.7976931348623157E308"
                                 GridPane.columnIndex="1"
                                 GridPane.rowIndex="2" />

               </children>

            </GridPane>

            <BorderPane>

               <left>
                  <Button fx:id="btnCambiarContrasena"
                          mnemonicParsing="false"
                          onAction="#leerNuevaContraseña"
                          text="Cambiar contraseña"
                          styleClass="boton-accion"
                          BorderPane.alignment="CENTER" />
               </left>

               <right>
                  <Button fx:id="btnCancelar"
                          mnemonicParsing="false"
                          onAction="#regresarPerfil"
                          text="Cancelar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER" />
               </right>

               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>

            </BorderPane>

         </children>

         <padding>
            <Insets top="40.0"
                    right="40.0"
                    bottom="40.0"
                    left="40.0" />
         </padding>

      </VBox>

   </children>

</VBox>