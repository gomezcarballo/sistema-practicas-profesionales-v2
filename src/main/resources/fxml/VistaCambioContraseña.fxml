<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.perfilusuario.ControladorCambioContraseña">
   <children>
      <Label fx:id="lblTituloNuevaContrasena" layoutX="227.0" layoutY="61.0" text="Cambio de Contraseña">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblInstruccion" layoutX="145.0" layoutY="102.0" text="Por favor, agregue una nueva contraseña segura de 10 caracteres" />
      <PasswordField fx:id="pfContraseñaActual" layoutX="244.0" layoutY="148.0" prefHeight="26.0" prefWidth="244.0" />
      <PasswordField fx:id="pfNuevaContraseña" layoutX="244.0" layoutY="200.0" prefHeight="26.0" prefWidth="244.0" />
      <PasswordField fx:id="pfContraseñaConfirmada" layoutX="244.0" layoutY="256.0" prefHeight="26.0" prefWidth="244.0" />
      <Label fx:id="lblContrasenaActual" layoutX="115.0" layoutY="152.0" text="Contraseña actual" />
      <Label fx:id="lblNuevaContrasena" layoutX="115.0" layoutY="204.0" text="Nueva contraseña" />
      <Label fx:id="lblConfirmacionContrasena" layoutX="90.0" layoutY="260.0" text="Confirme nueva contraseña" />
      <Button fx:id="btnCambiarContrasena" layoutX="193.0" layoutY="327.0" mnemonicParsing="false" onAction="#leerNuevaContraseña" text="Cambiar contraseña" />
      <Button fx:id="btnCancelar" layoutX="335.0" layoutY="327.0" mnemonicParsing="false" onAction="#regresarPerfil" prefHeight="26.0" prefWidth="86.0" text="Cancelar" />
   </children>
</AnchorPane>
