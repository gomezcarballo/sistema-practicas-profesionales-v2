<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="425.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorRegistroPracticante">
   <children>
      <Label fx:id="lblTituloFormulario" layoutX="215.0" layoutY="29.0" prefHeight="27.0" prefWidth="170.0" text="Registrar Practicante">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblNombre" layoutX="69.0" layoutY="91.0" prefHeight="18.0" prefWidth="142.0" text="Nombre del Practicante:" />
      <Label fx:id="lblApellidoPaterno" layoutX="70.0" layoutY="131.0" prefHeight="18.0" prefWidth="182.0" text="Apellido paterno del Practicante:" />
      <Label fx:id="lblApellidoMaterno" layoutX="70.0" layoutY="166.0" prefHeight="18.0" prefWidth="182.0" text="Apellido materno del Practicante:" />
      <Label fx:id="lblGenero" layoutX="69.0" layoutY="276.0" prefHeight="18.0" prefWidth="132.0" text="Género del Practicante:" />
      <Label fx:id="lblFechaNacimiento" layoutX="69.0" layoutY="310.0" prefHeight="18.0" prefWidth="156.0" text="Fecha de nacimiento:" />
      <Label fx:id="lblLenguaIndigena" layoutX="70.0" layoutY="345.0" text="¿Habla alguna lengua indígena?:" />
      <Label fx:id="lblMatricula" layoutX="69.0" layoutY="203.0" prefHeight="18.0" prefWidth="142.0" text="Matricula del Practicante:" />
      <TextField fx:id="txtNombre" layoutX="255.0" layoutY="87.0" prefHeight="26.0" prefWidth="270.0" promptText="Ingrese nombre" />
      <TextField fx:id="txtApellidoPaterno" layoutX="256.0" layoutY="127.0" prefHeight="26.0" prefWidth="270.0" promptText="Ingrese apellido paterno" />
      <TextField fx:id="txtApellidoMaterno" layoutX="256.0" layoutY="162.0" prefHeight="26.0" prefWidth="270.0" promptText="Ingrese apellido materno" />
      <ComboBox fx:id="cbOpcionesGenero" layoutX="256.0" layoutY="272.0" prefHeight="26.0" prefWidth="270.0" promptText="Ingrese género" />
      <DatePicker fx:id="dpFechaNacimiento" layoutX="256.0" layoutY="306.0" prefHeight="26.0" prefWidth="270.0" promptText="Ingrese fecha de nacimiento" />
