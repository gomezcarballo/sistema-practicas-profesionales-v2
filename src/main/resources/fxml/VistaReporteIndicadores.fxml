<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorReporteIndicadores">

    <children>

        <VBox fx:id="vbTarjetaReporte"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER"
                      spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloReporteIndicadores"
                               text="Reporte de Indicadores de Practicantes"
                               styleClass="etiqueta-titulo"/>

                        <Label fx:id="lblInstruccion"
                               text="Consulte los indicadores registrados y genere el reporte en PDF"
                               styleClass="etiqueta-instruccion"
                               wrapText="true"/>

                    </children>

                </VBox>

                <TableView fx:id="tblIndicadores"
                           prefHeight="220.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colIndicador"
                                     text="Indicador"
                                     prefWidth="300.0"
                                     reorderable="false"/>

                        <TableColumn fx:id="colValor"
                                     text="Cantidad"
                                     prefWidth="200.0"
                                     reorderable="false"/>

                    </columns>

                </TableView>

                <HBox alignment="CENTER"
                      spacing="15.0">

                    <children>

                        <Button fx:id="btnDescargarReporte"
                                mnemonicParsing="false"
                                text="Descargar PDF"
                                styleClass="boton-accion"/>

                        <Button fx:id="btnRegresar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                text="Regresar"
                                styleClass="boton-cancelar"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
