                  <Font name="Calibri Bold" size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblNombre" layoutX="74.0" layoutY="93.0" text="Nombre del Coordinador" />
            <Label fx:id="lblApellidoPaterno" layoutX="72.0" layoutY="129.0" text="Apellido paterno del Coordinador" />
            <Label fx:id="lblNumeroPersonal" layoutX="74.0" layoutY="203.0" text="Número de Personal" />
            <Label fx:id="lblApellidoMaterno" layoutX="72.0" layoutY="165.0" text="Apellido materno del Coordinador" />
