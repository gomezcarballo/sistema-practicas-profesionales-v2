            <TextField fx:id="txtApellidoPaterno" layoutX="297.0" layoutY="125.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese el apellido paterno" />
            <TextField fx:id="txtApellidoMaterno" layoutX="299.0" layoutY="161.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese apellido materno" />
            <TextField fx:id="txtNumeroPersonal" layoutX="299.0" layoutY="199.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese número de personal" />
            <Button fx:id="btnRegistrar" layoutX="126.0" layoutY="322.0" mnemonicParsing="false" onAction="#leerDatosDelCoordinador" text="Registrar" />
            <Button fx:id="btnCancelar" layoutX="326.0" layoutY="322.0" mnemonicParsing="false" onAction="#regresar" text="Cancelar" />
            <Label fx:id="lblInstruccion" layoutX="207.0" layoutY="62.0" text="Ingrese los campos solicitados:">
                    <font>
                  <Font name="System Italic" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblCorreo" layoutX="74.0" layoutY="245.0" text="Correo institucional" />
            <TextField fx:id="txtCorreo" layoutX="297.0" layoutY="241.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese el correo" />
         </children>
      </Pane>
   </children>
