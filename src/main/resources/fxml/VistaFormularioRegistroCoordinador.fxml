<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="450.0" prefWidth="600.0" styleClass="panel-raiz" 
   stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
   fx:controller="spp.presentacion.controladores.administrador.ControladorRegistroCoordinador">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" 
         VBox.vgrow="ALWAYS">
         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">
               
               <padding>

                  <Insets bottom="40.0" top="40.0" />

               </padding>

               <children>

                  <VBox fx:id="vbTarjetaRegistro" alignment="CENTER" maxWidth="600.0" spacing="25.0" 
                     styleClass="tarjeta-blanca">

                     <children>  
                        
                        <VBox alignment="CENTER" spacing="5.0">

                           <children>

                              <Label fx:id="lblTituloFormulario" styleClass="etiqueta-titulo" 
                                 text="Registro de un nuevo Coordinador" />

                              <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" 
                                 text="Ingrese los campos solicitados:" />

                           </children>

                        </VBox>

                        <GridPane hgap="15.0" vgap="15.0">
                        
                           <columnConstraints>

                              <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="350.0" 
                                 minWidth="10.0" prefWidth="280.0" />

                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="270.0" />

                           </columnConstraints>

                           <children>

                              <Label fx:id="lblNombre" styleClass="etiqueta-campo" 
                                 text="Nombre del coordinador:" wrapText="true" GridPane.rowIndex="0" />

                              <TextField fx:id="txtNombre" maxWidth="1.7976931348623157E308" 
                                 promptText="Ingrese el nombre" styleClass="campo-entrada" 
                                 GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label fx:id="lblApellidoPaterno" styleClass="etiqueta-campo" 
                                 text="Apellido paterno del coordinador:" wrapText="true" 
                                 GridPane.rowIndex="1" />

                              <TextField fx:id="txtApellidoPaterno" maxWidth="1.7976931348623157E308" 
                                 promptText="Ingrese el apellido paterno" styleClass="campo-entrada" 
                                 GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label fx:id="lblApellidoMaterno" styleClass="etiqueta-campo" 
                                 text="Apellido materno del coordinador:" wrapText="true" 
                                 GridPane.rowIndex="2" />

                              <TextField fx:id="txtApellidoMaterno" maxWidth="1.7976931348623157E308" 
                                 promptText="Ingrese el apellido materno" styleClass="campo-entrada" 
                                 GridPane.columnIndex="1" GridPane.rowIndex="2" />

                              <Label fx:id="lblNumeroPersonal" styleClass="etiqueta-campo" 
                                 text="Número de personal:" wrapText="true" GridPane.rowIndex="3" />

                              <TextField fx:id="txtNumeroPersonal" maxWidth="1.7976931348623157E308" 
                                 promptText="Ingrese número de personal" styleClass="campo-entrada" 
                                 GridPane.columnIndex="1" GridPane.rowIndex="3" />

                              <Label fx:id="lblCorreo" styleClass="etiqueta-campo" 
                                 text="Correo institucional:" wrapText="true" GridPane.rowIndex="4" />

                              <TextField fx:id="txtCorreo" maxWidth="1.7976931348623157E308" 
                                 promptText="Ingrese el correo" styleClass="campo-entrada" 
                                 GridPane.columnIndex="1" GridPane.rowIndex="4" />

                           </children>
                           
                           <rowConstraints>
                           
                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" /> 

                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />

                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />

                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />

                              <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />

                           </rowConstraints>
                           
                        </GridPane>

                        <BorderPane>

                           <left>

                              <Button fx:id="btnRegistrar" mnemonicParsing="false" 
                                 onAction="#leerDatosDelCoordinador" styleClass="boton-accion" 
                                 text="Registrar" BorderPane.alignment="CENTER" />

                           </left>

                           <right>

                              <Button fx:id="btnCancelar" mnemonicParsing="false" 
                                 onAction="#regresar" styleClass="boton-cancelar" 
                                 text="Cancelar" BorderPane.alignment="CENTER" />

                           </right>

                           <VBox.margin>

                              <Insets top="10.0" />

                           </VBox.margin>

                        </BorderPane>

                     </children>

                     <padding>

                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />

                     </padding>

                  </VBox>

               </children>

            </VBox>
      
         </content> 

      </ScrollPane>
      
   </children>
   
</VBox>