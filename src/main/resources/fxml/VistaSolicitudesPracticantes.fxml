<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="418.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorSolicitudesPracticantes">

    <children>

        <VBox fx:id="vbTarjetaSolicitudes"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER"
                      spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloSolicitudesPracticantes"
                               text="Solicitudes de los Practicantes"
                               styleClass="etiqueta-titulo"/>

                        <Label fx:id="lblInstruccion"
                               text="Seleccione un practicante para ver sus proyectos solicitados"
                               styleClass="etiqueta-instruccion"
                               wrapText="true"/>

                    </children>

                </VBox>

                <TableView fx:id="tblPracticantes"
                           prefHeight="220.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="120.0"
                                     reorderable="false"/>

                        <TableColumn fx:id="colApellidoPaterno"
                                     text="Apellido paterno"
                                     prefWidth="140.0"
                                     reorderable="false"/>

                        <TableColumn fx:id="colApellidoMaterno"
                                     text="Apellido materno"
                                     prefWidth="140.0"
                                     reorderable="false"/>

                        <TableColumn fx:id="colMatricula"
                                     text="Matrícula"
                                     prefWidth="100.0"
                                     reorderable="false"/>

                    </columns>

                </TableView>

                <HBox alignment="CENTER"
                      spacing="15.0">

                    <children>

                        <Button fx:id="btnVerSolicitudes"
                                mnemonicParsing="false"
                                onAction="#verSolicitudes"
                                text="Ver solicitudes"
                                styleClass="boton-accion"/>

                        <Button fx:id="btnRegresar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                text="Regresar"
                                styleClass="boton-cancelar"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
