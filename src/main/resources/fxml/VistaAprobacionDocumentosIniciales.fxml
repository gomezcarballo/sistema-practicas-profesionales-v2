<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="350.0" prefWidth="500.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorAprobacionDocumentosIniciales">

    <children>
        <VBox fx:id="vbTarjetaAprobacion" alignment="CENTER" maxWidth="450.0" spacing="20.0" styleClass="tarjeta-blanca">
            <children>
                <Label fx:id="lblTitulo" styleClass="etiqueta-titulo" text="Aprobación Documentos Iniciales" />

                <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione una acción para el documento actual" />
                  <Button fx:id="btnVerDocumento" onAction="#verDocumento" prefWidth="140.0" styleClass="boton-accion" text="Ver Documento" />

                <Region prefHeight="10.0" />

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="btnAprobarDocumento" onAction="#aprobarDocumento" prefHeight="36.0" prefWidth="178.0" styleClass="boton-accion" text="Aprobar Documento" />
                        <Button fx:id="btnRechazarDocumento" onAction="#rechazarDocumento" prefHeight="36.0" prefWidth="180.0" styleClass="boton-cancelar" text="Rechazar Documento" />
                    </children>
                </HBox>

                <Region prefHeight="20.0" />
            <Button fx:id="btnRegresar" onAction="#regresar" prefHeight="36.0" prefWidth="103.0" styleClass="boton-cancelar" text="Regresar" />
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</VBox>
