<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.administrador.ControladorListaProfesoresActivos">

    <children>

        <VBox fx:id="vbTarjetaProfesores" alignment="CENTER" maxWidth="560.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloProfesoresActivos" styleClass="etiqueta-titulo" text="Profesores Activos" />

                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione un profesor para realizar una acción" wrapText="true" />

                    </children>

                </VBox>

                <TableView fx:id="tblProfesoresActivos" prefHeight="230.0" prefWidth="500.0" styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre" prefWidth="111.99999856948853" reorderable="false" text="Nombre" />

                        <TableColumn fx:id="colApellidoPaterno" prefWidth="116.00000762939453" reorderable="false" text="Apellido paterno" />

                        <TableColumn fx:id="colApellidoMaterno" prefWidth="126.4000244140625" reorderable="false" text="Apellido materno" />

                        <TableColumn fx:id="colCorreoInstitucional" prefWidth="144.00006103515625" reorderable="false" text="Correo institucional" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnInactivarProfesor" mnemonicParsing="false" onAction="#inactivarProfesor" styleClass="boton-cancelar" text="Inactivar" />

                        <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelar" styleClass="boton-cancelar" text="Regresar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>
