<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="spp.presentacion.controladores.administrador.ControladorRegistroNuevoAdministrador">
   <children>
      <Label fx:id="lblTituloFormulario" layoutX="165.0" layoutY="41.0" text="Registro de un Nuevo Administrador">
         <font>
            <Font name="Calibri Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblNombre" layoutX="84.0" layoutY="103.0" text="Nombre del Administrador" />
      <Label fx:id="lblApellidoPaterno" layoutX="82.0" layoutY="139.0" text="Apellido paterno del Administrador" />
      <Label fx:id="lblNumeroPersonal" layoutX="84.0" layoutY="213.0" text="Número de Personal" />
      <Label fx:id="lblApellidoMaterno" layoutX="82.0" layoutY="175.0" text="Apellido materno del Administrador" />
      <TextField fx:id="txtNombre" layoutX="307.0" layoutY="98.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese el nombre" />
      <TextField fx:id="txtApellidoPaterno" layoutX="307.0" layoutY="135.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese el apellido paterno" />
      <TextField fx:id="txtApellidoMaterno" layoutX="309.0" layoutY="171.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese apellido materno" />
      <TextField fx:id="txtNumeroPersonal" layoutX="309.0" layoutY="209.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese número de personal" />
      <Button fx:id="btnRegistrar" layoutX="194.0" layoutY="332.0" mnemonicParsing="false" onAction="#leerDatosDelAdministrador" text="Registrar" />
      <Button fx:id="btnCancelar" layoutX="336.0" layoutY="332.0" mnemonicParsing="false" onAction="#regresar" text="Cancelar" />
      <Label fx:id="lblInstruccion" layoutX="217.0" layoutY="72.0" text="Ingrese los campos solicitados:">
         <font>
            <Font name="System Italic" size="12.0" />
         </font>
      </Label>
      <Label fx:id="lblCorreo" layoutX="84.0" layoutY="255.0" text="Correo institucional" />
      <TextField fx:id="txtCorreo" layoutX="307.0" layoutY="251.0" prefHeight="25.0" prefWidth="162.0" promptText="Ingrese el correo" />
   </children>
</AnchorPane>
