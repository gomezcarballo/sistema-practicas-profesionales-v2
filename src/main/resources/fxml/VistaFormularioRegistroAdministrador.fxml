<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="450.0" prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.administrador.ControladorRegistroNuevoAdministrador">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                  styleClass="scroll-pane"
                  VBox.vgrow="ALWAYS">
         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets bottom="40.0" top="40.0" />
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaRegistro"
                        alignment="CENTER"
                        maxWidth="500.0"
                        spacing="20.0"
                        styleClass="tarjeta-blanca">

                     <children>

                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label fx:id="lblTituloFormulario"
                                     styleClass="etiqueta-titulo"
                                     text="Registro de un Nuevo Administrador" />

                              <Label fx:id="lblInstruccion"
                                     styleClass="etiqueta-instruccion"
                                     text="Ingrese los campos solicitados:" />
                           </children>
                        </VBox>

                        <GridPane hgap="15.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES"
                                                 maxWidth="250.0" minWidth="10.0"
                                                 prefWidth="220.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="10.0"
                                                 prefWidth="270.0" />
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                              <RowConstraints minHeight="10.0" prefHeight="30.0" />
                           </rowConstraints>

                           <children>

                              <Label fx:id="lblNombre"
                                     styleClass="etiqueta-campo"
                                     text="Nombre del administrador:"
                                     GridPane.rowIndex="0" />
                              <TextField fx:id="txtNombre"
                                         styleClass="campo-entrada"
                                         promptText="Ingrese el nombre"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="0" />

                              <Label fx:id="lblApellidoPaterno"
                                     styleClass="etiqueta-campo"
                                     text="Apellido paterno:"
                                     GridPane.rowIndex="1" />
                              <TextField fx:id="txtApellidoPaterno"
                                         styleClass="campo-entrada"
                                         promptText="Ingrese apellido paterno"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="1" />

                              <Label fx:id="lblApellidoMaterno"
                                     styleClass="etiqueta-campo"
                                     text="Apellido materno:"
                                     GridPane.rowIndex="2" />
                              <TextField fx:id="txtApellidoMaterno"
                                         styleClass="campo-entrada"
                                         promptText="Ingrese apellido materno"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="2" />

                              <Label fx:id="lblNumeroPersonal"
                                     styleClass="etiqueta-campo"
                                     text="Número de personal:"
                                     GridPane.rowIndex="3" />
                              <TextField fx:id="txtNumeroPersonal"
                                         styleClass="campo-entrada"
                                         promptText="Ingrese número de personal"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="3" />

                              <Label fx:id="lblCorreo"
                                     styleClass="etiqueta-campo"
                                     text="Correo institucional:"
                                     GridPane.rowIndex="4" />
                              <TextField fx:id="txtCorreo"
                                         styleClass="campo-entrada"
                                         promptText="Ingrese el correo"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="4" />

                           </children>
                        </GridPane>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnRegistrar"
                                      text="Registrar"
                                      onAction="#leerDatosDelAdministrador"
                                      styleClass="boton-accion"
                                      BorderPane.alignment="CENTER" />
                           </left>

                           <right>
                              <Button fx:id="btnCancelar"
                                      text="Cancelar"
                                      onAction="#regresar"
                                      styleClass="boton-cancelar"
                                      BorderPane.alignment="CENTER" />
                           </right>

                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>

                  </VBox>

               </children>
            </VBox>

         </content>
      </ScrollPane>

   </children>
</VBox>
