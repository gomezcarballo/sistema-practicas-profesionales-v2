<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      prefHeight="280.0"
      prefWidth="420.0"
      styleClass="alerta-dialogo"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.ControladorErroresValidacion">

    <children>

        <HBox alignment="CENTER_LEFT" prefHeight="40.0" styleClass="header-panel">
            <padding>
                <Insets left="15.0" right="15.0" />
            </padding>
            <children>
                <Label text="⚠  Advertencia de Validación" />
            </children>
        </HBox>

        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            
            <padding>
                <Insets top="15.0" right="20.0" bottom="15.0" left="20.0"/>
            </padding>

            <children>
                <Label fx:id="lblInstruccionErrores"
                       text="Valor(es) invalido(s). Por favor, intente de nuevo:"
                       wrapText="true"
                       styleClass="content"/>

                <ListView fx:id="lvErrores"
                          prefHeight="120.0"
                          prefWidth="380.0" />

                <HBox alignment="CENTER_RIGHT">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="btnAceptar"
                                mnemonicParsing="false"
                                onAction="#aceptar"
                                prefWidth="100.0"
                                text="Aceptar"
                                styleClass="boton-accion"/>
                    </children>
                </HBox>

            </children>
        </VBox>

    </children>

</VBox>