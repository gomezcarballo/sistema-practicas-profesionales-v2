<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="605.0" prefWidth="821.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaOrganizaciones">

    <children>

        <VBox fx:id="vbTarjetaOrganizaciones" alignment="CENTER" maxWidth="694.0" prefHeight="550.0" prefWidth="694.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloOrganizaciones" styleClass="etiqueta-titulo" text="Organizaciones" />

                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione una organización y escoja una acción" wrapText="true" />

                    </children>

                </VBox>

                <TableView fx:id="tblListaOrganizaciones" prefHeight="220.0" prefWidth="500.0" styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre" prefWidth="210.39999628067017" reorderable="false" resizable="false" text="Nombre" />

                        <TableColumn fx:id="colSector" prefWidth="189.59996032714844" reorderable="false" text="Sector" />

                        <TableColumn fx:id="colDireccion" prefWidth="232.0" reorderable="false" text="Dirección" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="10.0">

                    <children>

                        <Button fx:id="btnVerMenuProyectos" mnemonicParsing="false" onAction="#abrirMenuProyectos" prefHeight="36.0" prefWidth="130.0" styleClass="boton-accion" text="Ver proyectos" />

                        <Button fx:id="btnVerDetalleOrganizacion" mnemonicParsing="false" onAction="#abrirDetalleOrganizacion" prefHeight="36.0" prefWidth="114.0" styleClass="boton-accion" text="Ver detalle" />

                        <Button fx:id="btnActualizarOrganizacion" mnemonicParsing="false" onAction="#abrirActualizarOrganizacion" styleClass="boton-accion" text="Actualizar" />

                        <Button fx:id="btnInactivarOrganizacion" mnemonicParsing="false" onAction="#abrirInactivarOrganizacion" styleClass="boton-cancelar" text="Inactivar" />

                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" styleClass="boton-cancelar" text="Regresar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>
