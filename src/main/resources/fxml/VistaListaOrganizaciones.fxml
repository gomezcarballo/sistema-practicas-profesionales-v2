<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaOrganizaciones">
   <children>
      <AnchorPane fx:id="pnlListaOrganizaciones" layoutX="23.0" layoutY="22.0" prefHeight="353.0" prefWidth="551.0">
         <children>
            <Label fx:id="lblTituloOrganizaciones" layoutX="204.0" layoutY="31.0" text="Organizaciones">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TableView fx:id="tblListaOrganizaciones" layoutX="32.0" layoutY="83.0" prefHeight="200.0" prefWidth="486.0">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="128.00006103515625" text="Nombre" />
                  <TableColumn fx:id="colSector" prefWidth="194.39996337890625" text="Sector" />
                  <TableColumn fx:id="colDireccion" prefWidth="163.20001220703125" text="Direccion" />
               </columns></TableView>
            <Button fx:id="btnVerDetalle" layoutX="121.0" layoutY="300.0" mnemonicParsing="false" onAction="#verDetalleOrganizacion" prefHeight="26.0" prefWidth="133.0" text="Ver detalle" />
