<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorAsignacionProyecto">
   <children>
      <AnchorPane layoutX="22.0" layoutY="22.0" prefHeight="361.0" prefWidth="558.0">
         <children>
            <Label fx:id="tituloAsignarProyecto" layoutX="192.0" layoutY="43.0" text="Asignar a un Proyecto">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="subtituloProyectosSolicitados" layoutX="176.0" layoutY="70.0" text="Proyectos solicitados por el Practicante" />
            <TableView fx:id="listaProyectosSolicitados" layoutX="25.0" layoutY="119.0" prefHeight="163.0" prefWidth="508.0">
               <columns>
                  <TableColumn fx:id="columnaNombre" prefWidth="118.4000244140625" text="Nombre" />
                  <TableColumn fx:id="columnaDescripcion" prefWidth="154.39996337890625" text="Descripcion" />
                  <TableColumn fx:id="columnaNombreResponsable" prefWidth="127.199951171875" text="NombreResponsable" />
                  <TableColumn fx:id="columnaCupoMaximo" prefWidth="107.20001220703125" text="Cupo máximo" />
               </columns></TableView>
            <Button fx:id="botonAsignar" layoutX="192.0" layoutY="302.0" mnemonicParsing="false" onAction="#asignarProyecto" text="Asignar" />
            <Button fx:id="botonCancelar" layoutX="304.0" layoutY="302.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            <Label fx:id="instruccion" layoutX="123.0" layoutY="88.0" text="Por favor, seleccione un proyecto para asignarlo al practicante" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
