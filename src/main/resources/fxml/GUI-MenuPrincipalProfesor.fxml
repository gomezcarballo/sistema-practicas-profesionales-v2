<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.menus.ControladorMenuPrincipalProfesor">
   <children>
      <Pane layoutX="23.0" layoutY="25.0" prefHeight="350.0" prefWidth="554.0">
         <children>
            <Label fx:id="tituloMenuProfesores" layoutX="154.0" layoutY="33.0" text="Menú Principal para Profesores">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="botonEvaluarReporte" layoutX="36.0" layoutY="93.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="134.0" text="Evaluar Reporte" />
            <Button fx:id="botonAnadirActividad" layoutX="196.0" layoutY="93.0" mnemonicParsing="false" prefHeight="39.0" prefWidth="134.0" text="Añadir Actividad" />
            <Button fx:id="botonCerrarSesion" layoutX="235.0" layoutY="311.0" mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
            <Button fx:id="botonAnadirPresentacion" layoutX="349.0" layoutY="93.0" mnemonicParsing="false" onAction="#agregarFormatoPresentacion" prefHeight="39.0" prefWidth="191.0" text="Añadir formato de presentación" />
            <Button fx:id="botonMensajes" layoutX="196.0" layoutY="156.0" mnemonicParsing="false" onAction="#abrirSubMenuMensajes" prefHeight="39.0" prefWidth="134.0" text="Mensajes" />
         </children>
      </Pane>
   </children>
</AnchorPane>
