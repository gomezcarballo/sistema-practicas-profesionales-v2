<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaProfesoresAsignacionEE">

    <children>

        <VBox fx:id="vbTarjetaProfesores" alignment="CENTER" maxWidth="560.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloListaProfesores" styleClass="etiqueta-titulo" text="Profesores" />

                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione un profesor para asignarle un grupo (Experiencia Educativa)" wrapText="true" />

                    </children>

                </VBox>

                <TableView fx:id="tblListaProfesores" prefHeight="220.0" prefWidth="500.0" styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre" prefWidth="120.0" reorderable="false" text="Nombre" />

                        <TableColumn fx:id="colApellidoPaterno" prefWidth="121.60004425048828" reorderable="false" text="Apellido paterno" />

                        <TableColumn fx:id="colApellidoMaterno" prefWidth="123.199951171875" reorderable="false" text="Apellido materno" />

                        <TableColumn fx:id="colCorreoInstitucional" prefWidth="136.0" reorderable="false" text="Correo Institucional" />

                    </columns>

                </TableView>

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnAsignar" mnemonicParsing="false" onAction="#asignarExperienciaEducativa" styleClass="boton-accion" text="Asignar EE" />

                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" styleClass="boton-cancelar" text="Regresar" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>
