<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="450.0"
      prefWidth="500.0"
      spacing="25.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.documentos.ControladorDocumentos">

    <children>

        <VBox fx:id="vbTarjetaDocumento"
              alignment="CENTER"
              maxWidth="420.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloDocumento"
                       styleClass="etiqueta-titulo"/>

                <Button fx:id="btnElegirDocumento"
                        onAction="#elegirDocumento"
                        prefHeight="40.0"
                        prefWidth="200.0"
                        text="Buscar archivo..."
                        styleClass="boton-accion"/>

                <VBox fx:id="vbPrevisualizacion"
                      alignment="CENTER"
                      managed="false"
                      spacing="10.0"
                      styleClass="contenedor-documento"
                      visible="false">

                    <children>

                        <Label text="📄"
                               styleClass="icono-documento"/>

                        <Label fx:id="lblNombreArchivo"
                               styleClass="nombre-documento"
                               text="nombre_archivo.pdf"/>

                        <Label fx:id="lblPesoArchivo"
                               styleClass="detalle-documento"
                               text="0 KB"/>

                    </children>

                    <padding>
                        <Insets top="20.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
                    </padding>

                </VBox>

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnCancelar"
                                onAction="#cancelar"
                                prefWidth="120.0"
                                text="Cancelar"
                                styleClass="boton-cancelar"/>

                        <Button fx:id="btnGuardar"
                                onAction="#subirDocumento"
                                prefWidth="180.0"
                                text="Guardar documento"
                                styleClass="boton-accion"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="35.0"
                        right="35.0"
                        bottom="35.0"
                        left="35.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
