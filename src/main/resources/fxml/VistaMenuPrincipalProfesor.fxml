<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.menus.ControladorMenuPrincipalProfesor">

    <children>

        <VBox fx:id="vbTarjetaMenuProfesor" alignment="CENTER" maxWidth="520.0" spacing="15.0" styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloMenuProfesores" styleClass="etiqueta-titulo" text="Menú Principal de Profesor" />

                <Button fx:id="btnEvaluarDocumento" mnemonicParsing="false" onAction="#abrirEvaluarDocumento" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Evaluar Documento" />

                <Button fx:id="btnCrearActividad" mnemonicParsing="false" onAction="#abrirRegistroNuevaActividad" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Crear Nueva Actividad" />

                <Button fx:id="btnSubirPresentacion" mnemonicParsing="false" onAction="#agregarFormatoPresentacion" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Subir Formato de Presentación" />

                <Button fx:id="btnMensajes" mnemonicParsing="false" onAction="#abrirSubMenuMensajes" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Mensajes" />

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnPerfil" mnemonicParsing="false" onAction="#abrirVerPerfil" prefHeight="36.0" prefWidth="143.0" styleClass="boton-accion" text="Perfil" />

                        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" prefWidth="120.0" styleClass="boton-cancelar" text="Cerrar sesión" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
            </padding>

        </VBox>

    </children>

</VBox>