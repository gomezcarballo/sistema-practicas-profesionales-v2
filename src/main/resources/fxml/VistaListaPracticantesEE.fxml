<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="605.0" prefWidth="821.0" spacing="20.0" styleClass="panel-raiz" 
stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="spp.presentacion.controladores.profesor.ControladorListaPracticantesEE">

    <children>

        <VBox fx:id="vbTarjetaPracticantes" alignment="CENTER" maxWidth="694.0" prefHeight="550.0" prefWidth="694.0" spacing="20.0" styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label fx:id="lblTituloPracticantes" styleClass="etiqueta-titulo" text="Lista de Alumnos" />
                        <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Alumnos inscritos en el grupo seleccionado" wrapText="true" />
                    </children>
                </VBox>

                <TableView fx:id="tblListaPracticantes" prefHeight="220.0" prefWidth="500.0" styleClass="tabla-estandar">
                    <columns>
                        <TableColumn fx:id="colMatricula" prefWidth="120.0" reorderable="false" resizable="false" text="Matrícula" />
                        <TableColumn fx:id="colNombre" prefWidth="170.0" reorderable="false" resizable="false" text="Nombre(s)" />
                        <TableColumn fx:id="colApellidoPaterno" prefWidth="170.0" reorderable="false" resizable="false" text="Apellido Paterno" />
                        <TableColumn fx:id="colApellidoMaterno" prefWidth="170.0" reorderable="false" resizable="false" text="Apellido Materno" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" prefHeight="36.0" prefWidth="110.0" styleClass="boton-cancelar" text="Regresar" />
                    </children>
                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>

</VBox>
