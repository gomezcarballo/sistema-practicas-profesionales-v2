<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="671.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorDetalleProyecto">

   <children>

      <ScrollPane fitToWidth="true"
                  hbarPolicy="NEVER"
                  vbarPolicy="AS_NEEDED"
                  styleClass="scroll-pane"
                  VBox.vgrow="ALWAYS">

         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets top="40.0" bottom="40.0"/>
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaDetalleProyecto"
                        alignment="CENTER"
                        maxWidth="600.0"
                        spacing="25.0"
                        styleClass="tarjeta-blanca">

                     <children>

                        <Label fx:id="lblTituloDetallesProyecto"
                               text="Detalles del Proyecto"
                               styleClass="etiqueta-titulo"/>

                        <GridPane hgap="15.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT"
                                                 hgrow="SOMETIMES"
                                                 prefWidth="220.0"/>
                              <ColumnConstraints hgrow="ALWAYS"
                                                 prefWidth="300.0"/>
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="90.0" vgrow="ALWAYS"/>
                              <RowConstraints prefHeight="150.0" vgrow="ALWAYS"/>
                           </rowConstraints>

                           <children>

                              <Label fx:id="lblNombreOrganizacion"
                                     text="Organización:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="0"/>

                              <TextField fx:id="txtNombreOrganizacion"
                                         editable="false"
                                         styleClass="campo-entrada"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="0"/>

                              <Label fx:id="lblNombre"
                                     text="Nombre:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="1"/>

                              <TextField fx:id="txtNombre"
                                         editable="false"
                                         styleClass="campo-entrada"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="1"/>

                              <Label fx:id="lblNombreResponsable"
                                     text="Nombre del responsable:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="2"/>

                              <TextField fx:id="txtNombreResponsable"
                                         editable="false"
                                         styleClass="campo-entrada"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="2"/>

                              <Label fx:id="lblContactoResponsable"
                                     text="Contacto:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="3"/>

                              <TextField fx:id="txtContactoResponsable"
                                         editable="false"
                                         styleClass="campo-entrada"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="3"/>

                              <Label fx:id="lblCupoMaximo"
                                     text="Cupo máximo:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="4"/>

                              <TextField fx:id="txtCupoMaximo"
                                         editable="false"
                                         styleClass="campo-entrada"
                                         maxWidth="1.7976931348623157E308"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="4"/>

                              <Label fx:id="lblObjetivoGeneral"
                                     text="Objetivo general:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="6"/>

                              <TextArea fx:id="taObjetivoGeneral"
                                        editable="false"
                                        wrapText="true"
                                        styleClass="area-texto"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="6"
                                        GridPane.vgrow="ALWAYS"/>

                              <Label fx:id="lblMetodologia"
                                     text="Metodología:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="7"/>

                              <TextArea fx:id="taMetodologia"
                                        editable="false"
                                        wrapText="true"
                                        styleClass="area-texto"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="7"
                                        GridPane.vgrow="ALWAYS"/>

                           </children>

                        </GridPane>

                        <BorderPane>
                           <center>
                              <Button fx:id="btnRegresar"
                                      mnemonicParsing="false"
                                      onAction="#regresar"
                                      text="Regresar"
                                      styleClass="boton-cancelar"
                                      BorderPane.alignment="CENTER"/>
                           </center>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets top="40.0"
                                bottom="40.0"
                                left="40.0"
                                right="40.0"/>
                     </padding>

                  </VBox>

               </children>

            </VBox>

         </content>

      </ScrollPane>

   </children>

</VBox>