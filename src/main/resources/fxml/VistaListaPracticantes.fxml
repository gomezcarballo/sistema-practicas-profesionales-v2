<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorListaPracticantes">
   <children>
      <AnchorPane fx:id="pnlListaPracticantes" layoutX="17.0" layoutY="14.0" prefHeight="371.0" prefWidth="565.0">
         <children>
            <TableView fx:id="tblListaPracticantes" layoutX="42.0" layoutY="86.0" prefHeight="200.0" prefWidth="497.0">
               <columns>
                  <TableColumn fx:id="colNombre" prefWidth="185.60003662109375" text="Nombre" />
                  <TableColumn fx:id="colApellidoPaterno" prefWidth="165.5999755859375" text="Apellido Paterno" />
                  <TableColumn fx:id="colApellidoMaterno" prefWidth="146.40008544921875" text="Apellido Materno" />
               </columns></TableView>
            <Label fx:id="lblTituloListaPracticantes" layoutX="237.0" layoutY="36.0" text="Practicantes">
               <font>
                  <Font name="Calibri" size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblInstruccion" layoutX="171.0" layoutY="58.0" prefHeight="18.0" prefWidth="257.0" text="Seleccione a un practicante para ver sus detalles">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
            </Label>
            <Button fx:id="btnInactivar" layoutX="237.0" layoutY="330.0" mnemonicParsing="false" onAction="#abrirInactivarPracticante" prefHeight="26.0" prefWidth="90.0" text="Inactivar" />
            <Button fx:id="btnVerDetallePracticante" layoutX="116.0" layoutY="330.0" mnemonicParsing="false" onAction="#abrirDetallePracticante" prefHeight="26.0" prefWidth="90.0" text="Ver detalles" />
            <Button fx:id="btnRegresar" layoutX="358.0" layoutY="330.0" mnemonicParsing="false" onAction="#regresar" prefHeight="26.0" prefWidth="90.0" text="Regresar" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
