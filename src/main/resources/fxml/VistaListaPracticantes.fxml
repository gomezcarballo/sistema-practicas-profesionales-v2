<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorListaPracticantes">

    <children>

        <VBox fx:id="vbTarjetaPracticantes"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER"
                      spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloListaPracticantes"
                               text="Practicantes"
                               styleClass="etiqueta-titulo"/>

                        <Label fx:id="lblInstruccion"
                               text="Seleccione un practicante para ver sus detalles"
                               styleClass="etiqueta-instruccion"
                               wrapText="true"/>

                    </children>

                </VBox>

                <TableView fx:id="tblListaPracticantes"
                           prefHeight="220.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="170.0"
                                     text="Nombre"
                                     reorderable="false"/>

                        <TableColumn fx:id="colApellidoPaterno"
                                     prefWidth="165.0"
                                     text="Apellido paterno"
                                     reorderable="false"/>

                        <TableColumn fx:id="colApellidoMaterno"
                                     prefWidth="165.0"
                                     text="Apellido materno"
                                     reorderable="false"/>

                    </columns>

                </TableView>

                <HBox alignment="CENTER"
                      spacing="15.0">

                    <children>

                        <Button fx:id="btnVerDetallePracticante"
                                mnemonicParsing="false"
                                onAction="#abrirDetallePracticante"
                                text="Ver detalles"
                                styleClass="boton-accion"/>

                        <Button fx:id="btnInactivar"
                                mnemonicParsing="false"
                                onAction="#abrirInactivarPracticante"
                                text="Inactivar"
                                styleClass="boton-cancelar"/>

                        <Button fx:id="btnRegresar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                text="Regresar"
                                styleClass="boton-cancelar"/>

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>