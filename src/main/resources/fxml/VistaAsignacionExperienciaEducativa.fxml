<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="500.0" prefWidth="650.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorAsignacionExperienciaEducativa">

    <children>

        <VBox fx:id="vbTarjetaAsignacionEE" alignment="CENTER" maxWidth="600.0" spacing="15.0" styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloAsignarEE" styleClass="etiqueta-titulo" text="Asignación Experiencia Educativa" />

                <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Seleccione una EE para asignarla al practicante" />

                <TableView fx:id="tblListaEE" prefHeight="250.0" prefWidth="550.0" styleClass="tabla-estandar">

                    <columns>
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />

                        <TableColumn fx:id="colPeriodo" prefWidth="120.0" text="Periodo" />

                        <TableColumn fx:id="colNRC" prefWidth="100.0" text="NRC" />

                        <TableColumn fx:id="colProfesor" prefWidth="150.0" text="Profesor" />
                    </columns>

                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="15.0">

                    <children>
                        <Button fx:id="btnVerHorario" mnemonicParsing="false" onAction="#verHorario" prefWidth="140.0" styleClass="boton-accion" text="Ver Horario" />

                        <Button fx:id="btnVerPlan" mnemonicParsing="false" onAction="#verPlanActividades" prefHeight="36.0" prefWidth="198.0" styleClass="boton-accion" text="Ver Plan de actividades" />
                    </children>

                </HBox>

                <Region prefHeight="10.0" />

                <HBox alignment="CENTER" spacing="15.0">

                    <children>
                        <Button fx:id="btnAsignar" mnemonicParsing="false" onAction="#asignarEE" prefWidth="140.0" styleClass="boton-accion" text="Asignar" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" prefWidth="140.0" styleClass="boton-cancelar" text="Regresar" />
                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>

        </VBox>

    </children>
    
</VBox>
