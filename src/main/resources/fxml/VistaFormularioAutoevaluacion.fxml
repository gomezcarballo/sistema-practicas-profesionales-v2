<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="700.0" prefWidth="750.0" styleClass="panel-raiz" 
stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" 
fx:controller="spp.presentacion.controladores.practicante.ControladorAutoevaluacion">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED" 
      VBox.vgrow="ALWAYS">

         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets bottom="40.0" top="40.0" />
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaAutoevaluacion" alignment="CENTER" maxWidth="680.0" spacing="25.0" 
                  styleClass="tarjeta-blanca">

                     <children>

                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label fx:id="lblTituloFormulario" styleClass="etiqueta-titulo" 
                              text="Autoevaluación del Alumno" />

                              <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" 
                              text="Califique cada afirmación con un número del 1 (Totalmente en desacuerdo) al 5 (Totalmente de acuerdo)" 
                              textAlignment="CENTER" wrapText="true" />
                           </children>
                        </VBox>

                        <GridPane hgap="20.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" prefWidth="480.0" />
                              <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" prefWidth="100.0" />
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="40.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                              <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                           </rowConstraints>

                           <children>

                              <Label text="1. Mi participación en la Organización Vinculada fue productiva."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorPrimeraAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                              <Label text="2. Logré la aplicación de los conocimientos teórico-prácticos adquiridos en la Licenciatura en Ingeniería de Software."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorSegundaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                              <Label text="3. Me sentí seguro al realizar las actividades encomendadas."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorTerceraAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                              <Label text="4. Las actividades encomendadas despertaron mi interés."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorCuartaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                              <Label text="5. La Organización Vinculada me proporcionó la información y facilidades adecuados durante el desarrollo de las prácticas."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorQuintaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                              <Label text="6. La Organización Vinculada me dio a conocer las reglas internas que debía seguir al conducirme durante el desarrollo de las prácticas."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorSextaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                              <Label text="7. El Responsable del Proyecto me orientó correctamente para el desarrollo de mis actividades."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorSeptimaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                              <Label text="8. El Responsable del Proyecto realizó un seguimiento efectivo de mis actividades."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorOctavaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                              <Label text="9. El proyecto es congruente con la formación de mi carrera."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorNovenaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                              <Label text="10. Considero que las prácticas son importantes para mi formación profesional."
                                     styleClass="etiqueta-afirmacion" wrapText="true"
                                     GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                              <TextField fx:id="txtValorDecimaAfirmacion"
                                         promptText="Valor 1-5" onKeyTyped="#validarNumeros"
                                         styleClass="campo-entrada" maxWidth="80.0" alignment="CENTER"
                                         GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                           </children>
                        </GridPane>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnGuardar" onAction="#leerDatosDeAutoevaluacion" 
                                 styleClass="boton-accion" text="Generar Autoevaluación" 
                                 BorderPane.alignment="CENTER" />
                           </left>

                           <right>
                              <Button fx:id="btnCancelar" onAction="#regresar" styleClass="boton-cancelar" 
                                 text="Regresar" BorderPane.alignment="CENTER" />
                           </right>

                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>

                  </VBox>

               </children>

            </VBox>

         </content>

      </ScrollPane>

   </children>

</VBox>
