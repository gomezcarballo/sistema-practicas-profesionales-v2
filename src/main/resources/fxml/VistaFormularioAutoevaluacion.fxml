<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="650.0" prefWidth="650.0" spacing="20.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.practicante.ControladorAutoevaluacion">
   <children>
      <Label fx:id="lblTituloFormularioAutoevaluacion" text="Formulario de Autoevaluación">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="25.0" style="-fx-padding: 10 20 10 10;">
               <children>
                  
                  <VBox spacing="10.0">
                     <children>
                        <Label text="1. ¿Qué objetivos de aprendizaje cubriste este periodo?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taObjetivos" prefRowCount="3" wrapText="true" promptText="Describe los objetivos alcanzados..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="2. ¿Qué aprendiste?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taAprendizaje" prefRowCount="3" wrapText="true" promptText="Menciona los nuevos conocimientos o herramientas adquiridas..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="3. ¿Qué necesitas mejorar?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taMejora" prefRowCount="3" wrapText="true" promptText="Identifica áreas de oportunidad o habilidades a reforzar..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="4. ¿Cómo te sentiste?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taSentimientos" prefRowCount="3" wrapText="true" promptText="Describe tu estado de ánimo, motivación y adaptación al entorno..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="5. ¿Cuál es tu experiencia al realizar tus Prácticas Profesionales?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taExperiencia" prefRowCount="3" wrapText="true" promptText="Haz un balance general de tu experiencia hasta ahora..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="6. ¿Cuáles fueron los principales obstáculos o desafíos técnicos que enfrentaste?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taDesafiosAbordados" prefRowCount="3" wrapText="true" promptText="Menciona problemas específicos y cómo los abordaste..." />
                     </children>
                  </VBox>

                  <VBox spacing="10.0">
                     <children>
                        <Label text="7. ¿Cómo aplicaste tus conocimientos académicos (ej. modelado de software, bases de datos) en tus actividades?">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <TextArea fx:id="taAplicacionConocimiento" prefRowCount="3" wrapText="true" promptText="Relaciona lo aprendido en clases con tus tareas en las prácticas..." />
                     </children>
                  </VBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
      
      <HBox alignment="CENTER" spacing="30.0" style="-fx-padding: 10 0 0 0;">
         <children>
            <Button fx:id="btnGenerar" mnemonicParsing="false" onAction="#leerDatosDeAutoevaluacion" prefHeight="30.0" prefWidth="120.0"  text="Guardar Reporte" />
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" prefHeight="30.0" prefWidth="120.0" text="Regresar" />
         </children>
      </HBox>
   </children>
</VBox>