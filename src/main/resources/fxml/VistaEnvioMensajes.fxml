<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.mensajeria.ControladorEnvioMensajes">

   <children>

      <VBox fx:id="vbTarjetaEnvioMensaje"
            alignment="CENTER"
            maxWidth="600.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label fx:id="lblTituloEnvioMensaje"
                         text="Enviar Mensaje"
                         styleClass="etiqueta-titulo" />

                  <Label text="Ingrese los campos solicitados:"
                         styleClass="etiqueta-instruccion" />
               </children>
            </VBox>

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     hgrow="SOMETIMES"
                                     prefWidth="150.0" />

                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="320.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="160.0"
                                  vgrow="ALWAYS" />
               </rowConstraints>

               <children>

                  <Label fx:id="lblDestinatario"
                         text="Destinatario:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0" />

                  <TextField fx:id="txtDestinatario"
                             promptText="Ingrese el destinatario"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0" />

                  <Label fx:id="lblAsunto"
                         text="Asunto:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1" />

                  <TextField fx:id="txtAsunto"
                             promptText="Ingrese el asunto"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1" />

                  <Label fx:id="lblCuerpo"
                         text="Cuerpo:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2" />

                  <TextArea fx:id="taCuerpoMensaje"
                            promptText="Escriba el mensaje"
                            styleClass="area-texto"
                            wrapText="true"
                            maxWidth="1.7976931348623157E308"
                            maxHeight="1.7976931348623157E308"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"
                            GridPane.vgrow="ALWAYS" />

               </children>

            </GridPane>

            <BorderPane>

               <left>
                  <Button fx:id="btnCancelar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Cancelar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER" />
               </left>

               <right>
                  <Button fx:id="btnEnviar"
                          mnemonicParsing="false"
                          onAction="#leerDatosMensaje"
                          text="Enviar"
                          styleClass="boton-accion"
                          BorderPane.alignment="CENTER" />
               </right>

               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>

            </BorderPane>

         </children>

         <padding>
            <Insets top="40.0"
                    right="40.0"
                    bottom="40.0"
                    left="40.0" />
         </padding>

      </VBox>

   </children>

</VBox>
