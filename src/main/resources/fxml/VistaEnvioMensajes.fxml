<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.mensajeria.ControladorEnvioMensajes">
   <children>
      <Label fx:id="lblTituloEnvioMensaje" layoutX="244.0" layoutY="55.0" text="Enviar Mensaje">
         <font>
            <Font name="Calibri" size="18.0" />
         </font>
      </Label>
      <Label fx:id="lblAsunto" layoutX="306.0" layoutY="96.0" text="Asunto:" />
      <Label fx:id="lblCuerpo" layoutX="45.0" layoutY="173.0" text="Cuerpo:" />
      <Label fx:id="lblDestinatario" layoutX="45.0" layoutY="96.0" text="Destinatario:" />
      <TextField fx:id="txtDestinatario" layoutX="44.0" layoutY="124.0" prefHeight="26.0" prefWidth="241.0" />
      <TextField fx:id="txtAsunto" layoutX="306.0" layoutY="125.0" prefHeight="26.0" prefWidth="263.0" />
      <Button fx:id="btnCancelar" layoutX="234.0" layoutY="352.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
      <Button fx:id="btnEnviar" layoutX="317.0" layoutY="352.0" mnemonicParsing="false" onAction="#leerDatosMensaje" prefHeight="26.0" prefWidth="62.0" text="Enviar" />
      <TextArea fx:id="taCuerpoMensaje" layoutX="45.0" layoutY="200.0" prefHeight="138.0" prefWidth="522.0" />
   </children>
</AnchorPane>
