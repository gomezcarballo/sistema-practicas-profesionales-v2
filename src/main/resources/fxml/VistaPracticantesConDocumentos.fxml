<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.profesor.ControladorPracticantesConDocumentos">

    <children>

        <VBox fx:id="vbTarjetaPracticantes"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER"
                      spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloPracticantes"
                               text="Lista de Practicantes"
                               styleClass="etiqueta-titulo"/>

                        <Label fx:id="lblInstruccion"
                               text="Seleccione un practicante de la tabla para ver sus documentos."
                               styleClass="etiqueta-instruccion"
                               wrapText="true"/>

                    </children>

                </VBox>

                <TableView fx:id="tblPracticantes"
                           prefHeight="250.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colMatricula"
                                     prefWidth="100.0"
                                     text="Matrícula"/>

                        <TableColumn fx:id="colNombre"
                                     prefWidth="130.0"
                                     text="Nombre"/>

                        <TableColumn fx:id="colApellidoPaterno"
                                     prefWidth="135.0"
                                     text="Apellido Paterno"/>

                        <TableColumn fx:id="colApellidoMaterno"
                                     prefWidth="135.0"
                                     text="Apellido Materno"/>

                    </columns>

                </TableView>

                <BorderPane>

                    <left>
                        <Button fx:id="btnVerDocumentos"
                                mnemonicParsing="false"
                                onAction="#verDocumentos"
                                text="Ver documentos"
                                styleClass="boton-accion"
                                BorderPane.alignment="CENTER"/>
                    </left>

                    <right>
                        <Button fx:id="btnRegresar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                text="Regresar"
                                styleClass="boton-cancelar"
                                BorderPane.alignment="CENTER"/>
                    </right>

                </BorderPane>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
