<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.profesor.ControladorRegistroNuevaActividad">

   <children>

      <VBox fx:id="vbTarjetaActividad"
            alignment="CENTER"
            maxWidth="600.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <VBox alignment="CENTER" spacing="5.0">

               <children>

                  <Label fx:id="lblTituloActividad"
                         text="Nueva Actividad"
                         styleClass="etiqueta-titulo" />

                  <Label fx:id="lblInstruccion"
                         text="Por favor, ingrese los datos solicitados"
                         styleClass="etiqueta-instruccion" />

               </children>

            </VBox>

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     hgrow="SOMETIMES"
                                     prefWidth="180.0" />

                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="320.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="140.0"
                                  vgrow="ALWAYS" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
               </rowConstraints>

               <children>

                  <Label fx:id="lblTitulo"
                         text="Título:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0" />

                  <TextField fx:id="txtTitulo"
                             promptText="Ingrese el título de la actividad"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0" />

                  <Label fx:id="lblDescripcion"
                         text="Descripción:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1" />

                  <TextArea fx:id="taDescripcion"
                            promptText="Ingrese la descripción de la actividad"
                            styleClass="area-texto"
                            wrapText="true"
                            maxWidth="1.7976931348623157E308"
                            maxHeight="1.7976931348623157E308"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"
                            GridPane.vgrow="ALWAYS" />

                  <Label fx:id="lblFechaLimite"
                         text="Fecha límite:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2" />

                  <DatePicker fx:id="dpFechaLimite"
                              promptText="Seleccione fecha"
                              styleClass="date-picker-personalizado"
                              maxWidth="1.7976931348623157E308"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="2" />

                  <Label text="Hora límite:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="3" />

                  <HBox spacing="10.0"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3">

                     <children>

                        <ComboBox fx:id="cbHoraLimite"
                                  promptText="Hora"
                                  styleClass="combo-box-personalizado"
                                  prefWidth="155.0" />

                        <ComboBox fx:id="cbMinutosLimite"
                                  promptText="Minutos"
                                  styleClass="combo-box-personalizado"
                                  prefWidth="155.0" />

                     </children>

                  </HBox>

               </children>

            </GridPane>

            <BorderPane>

               <left>
                  <Button fx:id="btnRegistrarActividad"
                          mnemonicParsing="false"
                          onAction="#leerDatosDeActividad"
                          text="Registrar Actividad"
                          styleClass="boton-accion"
                          BorderPane.alignment="CENTER" />
               </left>

               <right>
                  <Button fx:id="btnCancelar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Cancelar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER" />
               </right>

               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>

            </BorderPane>

         </children>

         <padding>
            <Insets top="40.0"
                    right="40.0"
                    bottom="40.0"
                    left="40.0" />
         </padding>

      </VBox>

   </children>

</VBox>
