<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.mensajeria.ControladorDetalleMensaje">

   <children>

      <VBox fx:id="vbTarjetaDetalleMensaje"
            alignment="CENTER"
            maxWidth="550.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <Label fx:id="lblTituloDetalleMensaje"
                   text="Detalle del Mensaje"
                   styleClass="etiqueta-titulo"/>

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     prefWidth="120.0"/>
                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="350.0"/>
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="140.0" vgrow="ALWAYS"/>
               </rowConstraints>

               <children>

                  <Label fx:id="lblAsunto"
                         text="Asunto:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="txtAsunto"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"/>

                  <Label fx:id="lblTipoCorreo"
                         text="Tipo:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1"/>

                  <TextField fx:id="txtCorreo"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"/>

                  <Label fx:id="lblFecha"
                         text="Fecha:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2"/>

                  <TextField fx:id="txtFecha"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"/>

                  <Label fx:id="lblContenido"
                         text="Contenido:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="3"/>

                  <TextArea fx:id="taCuerpo"
                            editable="false"
                            wrapText="true"
                            styleClass="area-texto"
                            maxWidth="1.7976931348623157E308"
                            maxHeight="1.7976931348623157E308"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"
                            GridPane.vgrow="ALWAYS"/>

               </children>

            </GridPane>

            <BorderPane>
               <center>
                  <Button fx:id="btnRegresar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Regresar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER"/>
               </center>
            </BorderPane>

         </children>

         <padding>
            <Insets top="30.0"
                    right="30.0"
                    bottom="30.0"
                    left="30.0"/>
         </padding>

      </VBox>

   </children>

</VBox>