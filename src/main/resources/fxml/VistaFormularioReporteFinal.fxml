<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="500.0" prefWidth="700.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.practicante.ControladorFormularioReporteFinal">
   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">
               
               <padding>
                  <Insets bottom="40.0" top="40.0" />
               </padding>

               <children>
                  <VBox fx:id="vbTarjeta" alignment="CENTER" maxWidth="750.0" spacing="25.0" styleClass="tarjeta-blanca">
                     
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>
                     
                     <children>  
                        
                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label fx:id="lblTitulo" styleClass="etiqueta-titulo" text="Avance de Actividades" />
                              <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Ingrese el porcentaje de avance y observaciones (Doble clic para editar):" />
                           </children>
                        </VBox>

                        <TableView fx:id="tblActividades" editable="true" prefHeight="250.0" styleClass="tabla-estandar" VBox.vgrow="ALWAYS">
                          <columns>
                          
                            <TableColumn fx:id="colActividad" editable="false" prefWidth="250.0" text="Actividad Programada" />
                            
                            <TableColumn fx:id="colAvance" prefWidth="100.0" text="\% Avance" />
                            <TableColumn fx:id="colObservaciones" prefWidth="250.0" text="Observaciones" />
                            <TableColumn fx:id="colEntregable" prefWidth="100.0" text="¿Entregable?" />
                          </columns>
                          
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnGenerarReporte" mnemonicParsing="false" onAction="#generarReporte" styleClass="boton-accion" text="Generar Reporte" BorderPane.alignment="CENTER" />
                           </left>
                           <right>
                              <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#regresar" styleClass="boton-cancelar" text="Cancelar" BorderPane.alignment="CENTER" />
                           </right>
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </BorderPane>

                     </children>
                  </VBox>
               </children>
            </VBox>
      
         </content> 
      </ScrollPane>
      
   </children>
</VBox>