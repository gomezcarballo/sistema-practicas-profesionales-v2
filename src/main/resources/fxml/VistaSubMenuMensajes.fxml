<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="spp.presentacion.menus.ControladorSubMenuMensajes">
   <children>
      <Label fx:id="lblTituloMensajes" layoutX="263.0" layoutY="56.0" text="Mensajes">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnMensajesRecibidos" layoutX="177.0" layoutY="119.0" mnemonicParsing="false" onAction="#abrirMensajesRecibidos" prefHeight="50.0" prefWidth="246.0" text="Mensajes Recibidos" />
      <Button fx:id="btnMensajesEnviados" layoutX="177.0" layoutY="188.0" mnemonicParsing="false" onAction="#abrirMensajesEnviados" prefHeight="50.0" prefWidth="246.0" text="Mensajes Enviados" />
      <Button fx:id="btnEnviarMensaje" layoutX="177.0" layoutY="260.0" mnemonicParsing="false" onAction="#abrirEnvioMensaje" prefHeight="50.0" prefWidth="246.0" text="Enviar Mensaje" />
      <Button fx:id="btnRegresar" layoutX="269.0" layoutY="338.0" mnemonicParsing="false" onAction="#regresar" text="Regresar" />
   </children>
</AnchorPane>
