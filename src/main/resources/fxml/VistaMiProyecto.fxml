<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="500.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.practicante.ControladorMiProyecto">

   <children>

      <VBox fx:id="vbTarjetaProyecto"
            alignment="CENTER"
            maxWidth="550.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <Label fx:id="lblTituloProyecto"
                   text="Mi Proyecto Asignado"
                   styleClass="etiqueta-titulo" />

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     hgrow="SOMETIMES"
                                     prefWidth="180.0" />

                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="280.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="100.0" valignment="TOP" />
               </rowConstraints>

               <children>

                  <Label text="Nombre del proyecto:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0" />

                  <TextField fx:id="txtNombre"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0" />

                  <Label text="Responsable:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1" />

                  <TextField fx:id="txtResponsable"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1" />

                  <Label text="Objetivo general:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2">
                     <GridPane.margin>
                        <Insets top="5.0" />
                     </GridPane.margin>
                  </Label>

                  <TextArea fx:id="txtObjetivoGeneral"
                            editable="false"
                            wrapText="true"
                            styleClass="campo-entrada"
                            maxWidth="1.7976931348623157E308"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2" />

               </children>

            </GridPane>

            <BorderPane>

               <right>
                  <Button fx:id="btnRegresar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Regresar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER" />
               </right>

               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>

            </BorderPane>

         </children>

         <padding>
            <Insets top="40.0"
                    right="40.0"
                    bottom="40.0"
                    left="40.0" />
         </padding>

      </VBox>

   </children>

</VBox>