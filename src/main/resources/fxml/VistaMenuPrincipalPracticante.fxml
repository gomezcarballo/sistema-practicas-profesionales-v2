<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.menus.ControladorMenuPrincipalPracticante">
   <children>
      <Pane fx:id="pnlMenuPracticante" layoutX="24.0" layoutY="24.0" prefHeight="353.0" prefWidth="550.0">
         <children>
            <Label fx:id="lblTituloMenuPracticante" layoutX="146.0" layoutY="26.0" text="Menú Principal para Practicantes">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Button fx:id="btnSolicitarProyecto" layoutX="185.0" layoutY="91.0" mnemonicParsing="false" onAction="#abrirSolicitarProyecto" prefHeight="35.0" prefWidth="178.0" text="Solicitar Proyecto" />
            <Button fx:id="btnCerrarSesion" layoutX="233.0" layoutY="291.0" mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
            <Button fx:id="btnGenerarReportes" layoutX="187.0" layoutY="136.0" mnemonicParsing="false" onAction="#abrirGenerarEvidenciaPracticas" prefHeight="35.0" prefWidth="178.0" text="Generar evidencia de Prácticas" />
            <Button fx:id="btnSubirEvidenciaPracticas" layoutX="186.0" layoutY="183.0" mnemonicParsing="false" onAction="#abrirAnadirEvidenciaPracticas" prefHeight="35.0" prefWidth="178.0" text="Subir evidencia de Prácticas" />
            <Button fx:id="btnMensajes" layoutX="186.0" layoutY="231.0" mnemonicParsing="false" onAction="#abrirSubMenuMensajes" prefHeight="35.0" prefWidth="178.0" text="Mensajes" />
         </children>
      </Pane>
   </children>
</AnchorPane>
