<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="20.0" styleClass="panel-raiz" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.menus.ControladorMenuPrincipalPracticante">

    <children>

        <VBox fx:id="vbTarjetaMenuPracticante" alignment="CENTER" maxWidth="520.0" spacing="15.0" styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lblTituloMenuPracticante" styleClass="etiqueta-titulo" text="Menú Principal de Practicante" />

                <Button fx:id="btnSolicitarProyecto" mnemonicParsing="false" onAction="#abrirSolicitarProyecto" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Solicitar Proyecto" />

                <Button fx:id="btnGenerarReportes" mnemonicParsing="false" onAction="#abrirGenerarEvidenciaPracticas" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Generar Evidencia de Prácticas" />

                <Button fx:id="btnSubirEvidenciaPracticas" mnemonicParsing="false" onAction="#abrirAnadirEvidenciaPracticas" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Subir Evidencia de Prácticas" />

                <Button fx:id="btnVerActividades" mnemonicParsing="false" onAction="#abrirListaActividades" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Ver Actividades Asignadas" />

                <Button fx:id="btnMensajes" mnemonicParsing="false" onAction="#abrirSubMenuMensajes" prefHeight="40.0" prefWidth="280.0" styleClass="boton-accion" text="Mensajes" />

                <HBox alignment="CENTER" spacing="15.0">

                    <children>

                        <Button fx:id="btnPerfil" mnemonicParsing="false" onAction="#abrirVerPerfil" prefHeight="36.0" prefWidth="146.0" styleClass="boton-accion" text="Perfil" />

                        <Button fx:id="btnCerrarSesion" mnemonicParsing="false" onAction="#cerrarSesion" prefWidth="120.0" styleClass="boton-cancelar" text="Cerrar sesión" />

                    </children>

                </HBox>

            </children>

            <padding>
                <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
            </padding>

        </VBox>

    </children>

</VBox>
