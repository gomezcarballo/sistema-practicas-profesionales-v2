<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="panelFormulario" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.administrador.ControladorRegistroProfesor">
   <children>
      <Label fx:id="textoTituloFormulario" layoutX="213.0" layoutY="61.0" text="Registrar Profesor">
         <font>
            <Font name="Calibri Light" size="24.0" />
         </font>
      </Label>
      <Label fx:id="textoNombre" layoutX="92.0" layoutY="141.0" text="Nombre del Profesor:" />
      <TextField fx:id="ingresaNombre" layoutX="273.0" layoutY="137.0" prefHeight="26.0" prefWidth="228.0" promptText="Ingrese el nombre" />
      <Label fx:id="textoApellidos" layoutX="92.0" layoutY="182.0" text="Apellido Paterno del Profesor:" />
      <TextField fx:id="ingresaApellidoPaterno" layoutX="273.0" layoutY="177.0" prefHeight="26.0" prefWidth="228.0" promptText="Ingrese el apellido paterno" />
      <Label fx:id="textoNumeroPersonal" layoutX="90.0" layoutY="249.0" prefHeight="28.0" prefWidth="182.0" text="Número de Personal del Profesor:" />
      <TextField fx:id="ingresaNumeroPersonal" layoutX="273.0" layoutY="250.0" prefHeight="26.0" prefWidth="228.0" promptText="Ingrese el número de personal" />
      <Button fx:id="botonRegistrar" layoutX="211.0" layoutY="304.0" mnemonicParsing="false" onAction="#leerDatosDelProfesor" text="Registrar" />
      <Button fx:id="botonCancelar" layoutX="318.0" layoutY="304.0" mnemonicParsing="false" text="Cancelar" />
      <Label layoutX="90.0" layoutY="218.0" text="Apellido Materno del Profesor:" />
      <TextField fx:id="ingresaApellidoMaterno" layoutX="273.0" layoutY="213.0" prefHeight="26.0" prefWidth="228.0" promptText="Ingrese el apellido materno" />
      <Label fx:id="textoInstruccion" layoutX="218.0" layoutY="105.0" text="Ingrese los campos solicitados:">
         <font>
            <Font name="System Italic" size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
