<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.practicante.ControladorSubirEvidenciaPracticas">

    <children>

        <VBox fx:id="vbTarjetaEvidencias"
              alignment="CENTER"
              maxWidth="500.0"
              spacing="15.0"
              styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="tituloGenerarEvidenciasPracticas"
                       text="Subir Evidencias de Prácticas"
                       styleClass="etiqueta-titulo"/>

                <Label text="Seleccione el tipo de evidencia que desea subir"
                       styleClass="etiqueta-instruccion"/>

                <Label text="Documentos de seguimiento"
                       styleClass="etiqueta-campo"/>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="botonReporteParcial"
                                mnemonicParsing="false"
                                onAction="#agregarReporteParcial"
                                prefHeight="40.0"
                                prefWidth="180.0"
                                text="Reporte Parcial"
                                styleClass="boton-accion"/>

                        <Button fx:id="botonReporteMensual"
                                mnemonicParsing="false"
                                onAction="#agregarReporteMensual"
                                prefHeight="40.0"
                                prefWidth="180.0"
                                text="Reporte Mensual"
                                styleClass="boton-accion"/>
                    </children>
                </HBox>

                <Button fx:id="botonBitacoraPSP"
                        mnemonicParsing="false"
                        onAction="#agregarBitacoraPSP"
                        prefHeight="40.0"
                        prefWidth="180.0"
                        text="Bitácora PSP"
                        styleClass="boton-accion"/>

                <Label text="Documentos de práctica"
                       styleClass="etiqueta-campo"/>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="botonHorario"
                                mnemonicParsing="false"
                                onAction="#agregarHorario"
                                prefHeight="40.0"
                                prefWidth="180.0"
                                text="Horario"
                                styleClass="boton-accion"/>

                        <Button fx:id="botonActividad"
                                mnemonicParsing="false"
                                onAction="#agregarActividad"
                                prefHeight="40.0"
                                prefWidth="180.0"
                                text="Actividad"
                                styleClass="boton-accion"/>
                    </children>
                </HBox>

                <Button fx:id="botonPlanActividades"
                        mnemonicParsing="false"
                        onAction="#agregarPlanActividades"
                        prefHeight="40.0"
                        prefWidth="180.0"
                        text="Plan de Actividades"
                        styleClass="boton-accion"/>

                <Label text="Evaluación"
                       styleClass="etiqueta-campo"/>

                <Button fx:id="botonAutoevaluacion"
                        mnemonicParsing="false"
                        onAction="#agregarAutoevaluacion"
                        prefHeight="40.0"
                        prefWidth="180.0"
                        text="Autoevaluación"
                        styleClass="boton-accion"/>

                <Button fx:id="botonCancelar"
                        mnemonicParsing="false"
                        onAction="#cancelar"
                        prefWidth="140.0"
                        text="Cancelar"
                        styleClass="boton-cancelar"/>

            </children>

            <padding>
                <Insets top="30.0"
                        right="35.0"
                        bottom="30.0"
                        left="35.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
