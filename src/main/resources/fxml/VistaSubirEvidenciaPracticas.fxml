<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.practicante.ControladorSubirEvidenciaPracticas">
    <children>
      <Pane layoutX="13.0" layoutY="15.0" prefHeight="370.0" prefWidth="574.0">
         <children>
            <Label fx:id="tituloGenerarEvidenciasPracticas" layoutX="163.0" layoutY="27.0" text="Subir Evidencias de Prácticas">
               <font>
                  <Font size="18.0" />
               </font></Label>
            <Button fx:id="botonReporteParcial" layoutX="80.0" layoutY="89.0" mnemonicParsing="false" onAction="#agregarReporteParcial" prefHeight="52.0" prefWidth="111.0" text="Reportes Parcial" />
            <Button fx:id="botonActividad" layoutX="391.0" layoutY="89.0" mnemonicParsing="false" onAction="#agregarActividad" prefHeight="52.0" prefWidth="111.0" text="Actividad" />
            <Button fx:id="botonReporteMensual" layoutX="80.0" layoutY="168.0" mnemonicParsing="false" onAction="#agregarReporteMensual" prefHeight="52.0" prefWidth="111.0" text="Reportes Mensual" />
            <Button fx:id="botonHorario" layoutX="232.0" layoutY="89.0" mnemonicParsing="false" onAction="#agregarHorario" prefHeight="52.0" prefWidth="111.0" text="Horario" />
            <Button fx:id="botonBitacoraPSP" layoutX="232.0" layoutY="168.0" mnemonicParsing="false" onAction="#agregarBitacoraPSP" prefHeight="52.0" prefWidth="111.0" text="Bitácora PSP" />
            <Button fx:id="botonPlanActividades" layoutX="222.0" layoutY="245.0" mnemonicParsing="false" onAction="#agregarPlanActividades" prefHeight="52.0" prefWidth="132.0" text="Plan de Actividades" />
            <Button fx:id="botonAutoevaluacion" layoutX="391.0" layoutY="168.0" mnemonicParsing="false" onAction="#agregarAutoevaluacion" prefHeight="52.0" prefWidth="111.0" text="Autoevaluación" />
            <Button fx:id="botonCancelar" layoutX="245.0" layoutY="319.0" mnemonicParsing="false" onAction="#cancelar" prefHeight="27.0" prefWidth="85.0" text="Cancelar" />
         </children>
      </Pane>
   </children>
</AnchorPane>
