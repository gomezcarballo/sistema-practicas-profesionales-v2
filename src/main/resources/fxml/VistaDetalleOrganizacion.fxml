<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorDetalleOrganizacion">

   <children>

      <VBox fx:id="vbTarjetaDetalle"
            alignment="CENTER"
            maxWidth="550.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <Label fx:id="lblTituloDetallesOrganizacion"
                   text="Detalles de la Organización"
                   styleClass="etiqueta-titulo" />

            <GridPane hgap="15.0" vgap="15.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     prefWidth="120.0" />

                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="320.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
                  <RowConstraints prefHeight="30.0" />
               </rowConstraints>

               <children>

                  <Label fx:id="lblNombre"
                         text="Nombre:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0" />

                  <TextField fx:id="txtNombre"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0" />

                  <Label fx:id="lblDireccion"
                         text="Dirección:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1" />

                  <TextField fx:id="txtDireccion"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1" />

                  <Label fx:id="lblSector"
                         text="Sector:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2" />

                  <TextField fx:id="txtSector"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2" />

               </children>

            </GridPane>

            <BorderPane>
               <center>
                  <Button fx:id="btnRegresar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Regresar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER" />
               </center>
            </BorderPane>

         </children>

         <padding>
            <Insets top="40.0"
                    right="40.0"
                    bottom="40.0"
                    left="40.0" />
         </padding>

      </VBox>

   </children>

</VBox>