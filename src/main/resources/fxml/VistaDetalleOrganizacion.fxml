<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" 
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorDetalleOrganizacion">
   <children>
       
      <AnchorPane fx:id="pnlDetalleOrganizacion" layoutX="28.0" layoutY="26.0" 
                  prefHeight="345.0" prefWidth="545.0">
         <children>
             
            <Label fx:id="lblTituloDetallesOrganizacion" layoutX="164.0" layoutY="62.0" 
                   text="Detalles de la Organización">
                
               <font>
                  <Font size="18.0" />
               </font>
               
            </Label>
            
            <Label fx:id="lblNombre" layoutX="80.0" layoutY="124.0" text="Nombre: " />
            <Label fx:id="lblDireccion" layoutX="79.0" layoutY="161.0" text="Dirección:" />
            <Label fx:id="lblSector" layoutX="80.0" layoutY="199.0" text="Sector:" />
            
            <TextField fx:id="txtNombre" layoutX="161.0" layoutY="120.0" prefHeight="26.0" prefWidth="179.0" />
            <TextField fx:id="txtDireccion" layoutX="161.0" layoutY="157.0" prefHeight="26.0" prefWidth="179.0" />
            <TextField fx:id="txtSector" layoutX="161.0" layoutY="194.0" prefHeight="26.0" prefWidth="179.0" />
            
            <Button fx:id="btnInactivarOrganizacion" layoutX="381.0" layoutY="133.0" mnemonicParsing="false" 
                    onAction="#abrirInactivarOrganizacion" prefHeight="26.0" prefWidth="142.0" text="Inactivar Organización" />
            <Button fx:id="btnActualizarOrganizacion" layoutX="381.0" layoutY="181.0" mnemonicParsing="false" 
                    onAction="#abrirActualizarOrganizacion" text="Actualizar Organización" />
            <Button fx:id="btnVerProyectos" layoutX="225.0" layoutY="280.0" mnemonicParsing="false" 
                    onAction="#verMenuProyectos" prefHeight="26.0" prefWidth="114.0" text="Ver proyectos" />
            
         </children>
         
      </AnchorPane>
      
   </children>
   
</AnchorPane>
