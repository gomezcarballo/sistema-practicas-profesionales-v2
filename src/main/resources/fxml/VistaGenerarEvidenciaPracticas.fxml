<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.practicante.ControladorGenerarEvidenciaPracticas">

    <children>

        <VBox fx:id="vbTarjetaGenerarEvidencias"
              alignment="CENTER"
              maxWidth="450.0"
              spacing="18.0"
              styleClass="tarjeta-blanca">

            <children>

                <Label fx:id="lbTituloGenerarEvidenciasPracticas"
                       text="Generar Evidencias de Prácticas"
                       styleClass="etiqueta-titulo"/>

                <Label text="Seleccione el tipo de evidencia que desea generar"
                       styleClass="etiqueta-instruccion"
                       wrapText="true"/>

                <Button fx:id="btnReporteParcial"
                        mnemonicParsing="false"
                        onAction="#abrirReporteParcial"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Reporte Parcial"
                        styleClass="boton-accion"/>

                <Button fx:id="btnReporteFinal"
                        mnemonicParsing="false"
                        onAction="#abrirReporteFinal"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Reporte Final"
                        styleClass="boton-accion"/>

                <Button fx:id="btnAutoevaluacion"
                        mnemonicParsing="false"
                        onAction="#abrirAutoevaluacion"
                        prefWidth="260.0"
                        prefHeight="40.0"
                        text="Autoevaluación"
                        styleClass="boton-accion"/>

                <Button fx:id="btnRegresar"
                        mnemonicParsing="false"
                        onAction="#regresar"
                        prefWidth="140.0"
                        text="Regresar"
                        styleClass="boton-cancelar"/>

            </children>

            <padding>
                <Insets top="35.0"
                        right="35.0"
                        bottom="35.0"
                        left="35.0"/>
            </padding>

        </VBox>

    </children>

</VBox>
