<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="432.0"
      prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorDetallePracticante">

   <children>

      <VBox fx:id="vbTarjetaDetalle"
            alignment="CENTER"
            maxWidth="560.0"
            spacing="25.0"
            styleClass="tarjeta-blanca">

         <children>

            <Label fx:id="lblTituloDetallesPracticante"
                   text="Detalles del Practicante"
                   styleClass="etiqueta-titulo" />

            <GridPane hgap="15.0" vgap="12.0">

               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT"
                                     prefWidth="220.0" />
                  <ColumnConstraints hgrow="ALWAYS"
                                     prefWidth="300.0" />
               </columnConstraints>

               <rowConstraints>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
                  <RowConstraints prefHeight="30.0"/>
               </rowConstraints>

               <children>

                  <Label fx:id="lblNombre"
                         text="Nombre del practicante:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="0"/>

                  <TextField fx:id="txtNombre"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="0"/>

                  <Label fx:id="lblApellidoPaterno"
                         text="Apellido paterno del practicante:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="1"/>

                  <TextField fx:id="txtApellidoPaterno"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="1"/>

                  <Label fx:id="lblApellidoMaterno"
                         text="Apellido materno del practicante:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="2"/>

                  <TextField fx:id="txtApellidoMaterno"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="2"/>

                  <Label fx:id="lblMatricula"
                         text="Matrícula:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="3"/>

                  <TextField fx:id="txtMatricula"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="3"/>

                  <Label fx:id="lblCorreo"
                         text="Correo institucional:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="4"/>

                  <TextField fx:id="txtCorreoInstitucional"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="4"/>

                  <Label fx:id="lblGenero"
                         text="Género:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="5"/>

                  <TextField fx:id="txtGenero"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="5"/>

                  <Label fx:id="lblFechaNacimiento"
                         text="Fecha de nacimiento:"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="6"/>

                  <TextField fx:id="txtFechaNacimiento"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="6"/>

                  <Label fx:id="lblLenguaIndigena"
                         text="¿Habla alguna lengua indígena?"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="7"/>

                  <TextField fx:id="txtHablaLenguaIndigena"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="7"/>

                  <Label fx:id="lblNrc"
                         text="Grupo (NRC):"
                         styleClass="etiqueta-campo"
                         GridPane.rowIndex="8"/>

                  <TextField fx:id="txtNrcAsignado"
                             editable="false"
                             styleClass="campo-entrada"
                             maxWidth="1.7976931348623157E308"
                             GridPane.columnIndex="1"
                             GridPane.rowIndex="8"/>

               </children>

            </GridPane>

            <BorderPane>
               <center>
                  <Button fx:id="btnRegresar"
                          mnemonicParsing="false"
                          onAction="#regresar"
                          text="Regresar"
                          styleClass="boton-cancelar"
                          BorderPane.alignment="CENTER"/>
               </center>
            </BorderPane>

         </children>

         <padding>
            <Insets top="30.0"
                    right="30.0"
                    bottom="30.0"
                    left="30.0"/>
         </padding>

      </VBox>

   </children>

</VBox>