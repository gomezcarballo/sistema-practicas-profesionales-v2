<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="600.0" prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.profesor.ControladorEvaluacionDocumentos">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                  styleClass="scroll-pane"
                  VBox.vgrow="ALWAYS">

         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets top="40.0" bottom="40.0"/>
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaEvaluacion"
                        alignment="CENTER"
                        maxWidth="600.0"
                        spacing="25.0"
                        styleClass="tarjeta-blanca">

                     <children>

                        <VBox alignment="CENTER" spacing="15.0">
                           <children>
                              <Label fx:id="lblTituloFormulario"
                                     text="Evaluar Documento"
                                     styleClass="etiqueta-titulo"/>

                              <Label fx:id="lblInstruccion"
                                     text="Revise el documento del practicante y asigne la calificación con sus respectivas observaciones."
                                     styleClass="etiqueta-instruccion"
                                     wrapText="true"
                                     textAlignment="CENTER"/>

                              <Button fx:id="btnVerArchivo"
                                      text="Ver archivo"
                                      onAction="#abrirDocumento"
                                      styleClass="boton-accion">
                                 <VBox.margin>
                                    <Insets top="5.0" />
                                 </VBox.margin>
                              </Button>
                           </children>
                        </VBox>

                        <GridPane hgap="15.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES"
                                                 prefWidth="180.0"/>
                              <ColumnConstraints hgrow="ALWAYS"
                                                 prefWidth="310.0"/>
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints prefHeight="30.0"/>
                              <RowConstraints prefHeight="100.0" vgrow="ALWAYS"/>
                           </rowConstraints>

                           <children>

                              <Label text="Calificación final:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="0"/>
                              <TextField fx:id="txtCalificacionFinal"
                                         promptText="Ingrese la calificación"
                                         onKeyReleased="#validarCalificacionFinal"
                                         styleClass="campo-entrada"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="0"/>

                              <Label text="Observaciones:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="1"
                                     GridPane.valignment="TOP">
                                 <GridPane.margin>
                                    <Insets top="8.0" />
                                 </GridPane.margin>
                              </Label>
                              <TextArea fx:id="taObservaciones"
                                        promptText="Ingrese sus observaciones o retroalimentación"
                                        styleClass="area-texto"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        wrapText="true"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"
                                        GridPane.vgrow="ALWAYS"/>

                           </children>

                        </GridPane>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnCalificar"
                                      text="Calificar"
                                      onAction="#registrarEvaluacion"
                                      styleClass="boton-accion"/>
                           </left>

                           <right>
                              <Button fx:id="btnCancelar"
                                      text="Cancelar"
                                      onAction="#cancelar"
                                      styleClass="boton-cancelar"/>
                           </right>

                           <VBox.margin>
                              <Insets top="10.0"/>
                           </VBox.margin>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets top="40.0" bottom="40.0" left="40.0" right="40.0"/>
                     </padding>

                  </VBox>

               </children>

            </VBox>

         </content>

      </ScrollPane>

   </children>

</VBox>