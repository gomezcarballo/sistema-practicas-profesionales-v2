<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="616.0" prefWidth="600.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.coordinador.ControladorGestionProyecto">

   <children>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                  styleClass="scroll-pane"
                  VBox.vgrow="ALWAYS">

         <content>

            <VBox alignment="CENTER" styleClass="panel-raiz">

               <padding>
                  <Insets top="40.0" bottom="40.0"/>
               </padding>

               <children>

                  <VBox fx:id="vbTarjetaProyecto"
                        alignment="CENTER"
                        maxWidth="600.0"
                        spacing="25.0"
                        styleClass="tarjeta-blanca">

                     <children>

                        <VBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label fx:id="lblTituloFormulario"
                                     text="Registrar Proyecto"
                                     styleClass="etiqueta-titulo"/>

                              <Label fx:id="lblInstruccion"
                                     text="Ingrese los campos solicitados"
                                     styleClass="etiqueta-instruccion"/>
                           </children>
                        </VBox>

                        <GridPane hgap="15.0" vgap="15.0">

                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES"
                                                 prefWidth="220.0"/>
                              <ColumnConstraints hgrow="ALWAYS"
                                                 prefWidth="270.0"/>
                           </columnConstraints>

                           <rowConstraints>
                              <RowConstraints prefHeight="30.0"/> <RowConstraints prefHeight="30.0"/> <RowConstraints prefHeight="30.0"/> <RowConstraints prefHeight="30.0"/> <RowConstraints prefHeight="90.0" vgrow="ALWAYS"/> <RowConstraints prefHeight="120.0" vgrow="ALWAYS"/> </rowConstraints>

                           <children>

                              <Label text="Nombre del proyecto:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="0"/>
                              <TextField fx:id="txtNombre"
                                         promptText="Ingrese el nombre"
                                         styleClass="campo-entrada"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="0"/>

                              <Label text="Nombre del responsable:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="1"/>
                              <TextField fx:id="txtNombreResponsable"
                                         promptText="Ingrese el responsable"
                                         styleClass="campo-entrada"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="1"/>

                              <Label text="Contacto del responsable:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="2"/>
                              <TextField fx:id="txtContactoResponsable"
                                         promptText="Ingrese el contacto"
                                         styleClass="campo-entrada"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="2"/>

                              <Label text="Cupo máximo:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="3"/>
                              <TextField fx:id="txtCupoMaximo"
                                         promptText="Ingrese el cupo máximo"
                                         onKeyReleased="#validarCupoMaximo"
                                         styleClass="campo-entrada"
                                         GridPane.columnIndex="1"
                                         GridPane.rowIndex="3"/>

                              <Label text="Objetivo general:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="4"/>
                              <TextArea fx:id="taObjetivoGeneral"
                                        promptText="Ingrese el objetivo general"
                                        styleClass="area-texto"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        wrapText="true"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="4"
                                        GridPane.vgrow="ALWAYS"/>

                              <Label text="Metodología:"
                                     styleClass="etiqueta-campo"
                                     GridPane.rowIndex="5"/>
                              <TextArea fx:id="taMetodologia"
                                        promptText="Ingrese la metodología"
                                        styleClass="area-texto"
                                        maxWidth="1.7976931348623157E308"
                                        maxHeight="1.7976931348623157E308"
                                        wrapText="true"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="5"
                                        GridPane.vgrow="ALWAYS"/>

                           </children>

                        </GridPane>

                        <BorderPane>
                           <left>
                              <Button fx:id="btnGuardar"
                                      text="Registrar"
                                      onAction="#leerDatosDeProyecto"
                                      styleClass="boton-accion"/>
                           </left>

                           <right>
                              <Button fx:id="btnCancelar"
                                      text="Cancelar"
                                      onAction="#cancelar"
                                      styleClass="boton-cancelar"/>
                           </right>

                           <VBox.margin>
                              <Insets top="10.0"/>
                           </VBox.margin>
                        </BorderPane>

                     </children>

                     <padding>
                        <Insets top="40.0" bottom="40.0" left="40.0" right="40.0"/>
                     </padding>

                  </VBox>

               </children>

            </VBox>

         </content>

      </ScrollPane>

   </children>

</VBox>
