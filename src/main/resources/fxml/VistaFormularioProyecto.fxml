<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="616.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorFormularioProyecto">
   <children>
      <AnchorPane fx:id="pnlFormularioProyecto" layoutX="34.0" layoutY="31.0" prefHeight="337.0" prefWidth="532.0">
         <children>
            <Label fx:id="lblTituloFormulario" layoutX="196.0" layoutY="42.0" text="Registrar Proyecto">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblNombre" layoutX="89.0" layoutY="108.0" text="Nombre del proyecto:" />
            <Label fx:id="lblDescripcion" layoutX="89.0" layoutY="160.0" text="Descripción:" />
            <Label fx:id="lblNombreResponsable" layoutX="87.0" layoutY="207.0" text="Nombre del responsable:" />
            <Label fx:id="lblCupoMaximo" layoutX="87.0" layoutY="286.0" text="Cupo máximo:" />
            <TextField fx:id="txtNombre" layoutX="269.0" layoutY="104.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el nombre" />
            <TextField fx:id="txtDescripcion" layoutX="269.0" layoutY="156.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese la descripcion" />
            <TextField fx:id="txtNombreResponsable" layoutX="269.0" layoutY="203.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el nombre del responsable" />
            <TextField fx:id="txtCupoMaximo" layoutX="267.0" layoutY="282.0" onKeyReleased="#validarCupoMaximo" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el cupo máximo" />
            <Label fx:id="lblInstruccion" layoutX="191.0" layoutY="69.0" text="Ingrese los campos solicitados">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblContactoResponsable" layoutX="87.0" layoutY="244.0" text="Contacto del responsable:" />
            <TextField fx:id="txtContactoResponsable" layoutX="269.0" layoutY="240.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el contacto" />
         </children>
      </AnchorPane>
      <Button fx:id="btnGuardar" layoutX="219.0" layoutY="564.0" mnemonicParsing="false" onAction="#leerDatosDeProyecto" text="Registrar" />
      <Button fx:id="btnCancelar" layoutX="300.0" layoutY="564.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
      <TextArea fx:id="taObjetivoGeneral" layoutX="301.0" layoutY="352.0" prefHeight="63.0" prefWidth="206.0" promptText="Ingrese el objetivo general" />
      <Label fx:id="lblObjetivoGeneral" layoutX="129.0" layoutY="375.0" text="Objetivo General:" />
      <TextArea fx:id="taMetodologia" layoutX="301.0" layoutY="426.0" prefHeight="122.0" prefWidth="206.0" promptText="Ingrese la metodología" />
      <Label fx:id="lblMetodologia" layoutX="129.0" layoutY="478.0" text="Metodología:" />
   </children>
</AnchorPane>
