<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.coordinador.ControladorFormularioProyecto">
   <children>
      <AnchorPane fx:id="pnlFormularioProyecto" layoutX="34.0" layoutY="31.0" prefHeight="337.0" prefWidth="532.0">
         <children>
            <Label fx:id="lblTituloFormulario" layoutX="196.0" layoutY="42.0" text="Registrar Proyecto">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Label fx:id="lblNombre" layoutX="89.0" layoutY="108.0" text="Nombre del proyecto:" />
            <Label fx:id="lblDescripcion" layoutX="89.0" layoutY="160.0" text="Descripción:" />
            <Label fx:id="lblNombreResponsable" layoutX="87.0" layoutY="207.0" text="Nombre del responsable:" />
            <Label fx:id="lblCupoMaximo" layoutX="89.0" layoutY="255.0" text="Cupo máximo:" />
            <TextField fx:id="txtNombre" layoutX="269.0" layoutY="104.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el nombre" />
            <TextField fx:id="txtDescripcion" layoutX="269.0" layoutY="156.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese la descripcion" />
            <TextField fx:id="txtNombreResponsable" layoutX="269.0" layoutY="203.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el nombre del responsable" />
            <TextField fx:id="txtCupoMaximo" layoutX="269.0" layoutY="251.0" prefHeight="26.0" prefWidth="206.0" promptText="Ingrese el cupo máximo" />
            <Button fx:id="btnGuardar" layoutX="170.0" layoutY="299.0" mnemonicParsing="false" onAction="#leerDatosDeProyecto" text="Registrar" />
            <Button fx:id="btnCancelar" layoutX="292.0" layoutY="299.0" mnemonicParsing="false" onAction="#cancelar" text="Cancelar" />
            <Label fx:id="lblInstruccion" layoutX="191.0" layoutY="69.0" text="Ingrese los campos solicitados">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
