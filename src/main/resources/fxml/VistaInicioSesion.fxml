<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz" alignment="CENTER" prefHeight="450.0" prefWidth="600.0" styleClass="panel-raiz" 
      stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="spp.presentacion.controladores.menus.ControladorInicioSesion">

   <children>
      
      <VBox fx:id="vbTarjetaInicio" alignment="CENTER" maxWidth="500.0" spacing="20.0" styleClass="tarjeta-blanca">
         
         <children>

           <Label fx:id="lblTituloSPP" styleClass="etiqueta-titulo" text="Sistema de Prácticas Profesionales" 
                  wrapText="true" textAlignment="CENTER" />

            <Label fx:id="lblSubtituloIniciarSesion" styleClass="etiqueta-subtitulo" text="Iniciar sesión" />

            <Label fx:id="lblInstruccion" styleClass="etiqueta-instruccion" text="Ingrese los campos solicitados:" />

            <VBox spacing="8.0" maxWidth="300.0">

               <children>

                  <Label fx:id="lblCorreoMatricula" styleClass="etiqueta-campo" text="Correo institucional o matrícula:" />

                  <TextField fx:id="txtCorreoMatricula" promptText="Ej: zS24012345 o juan@uv.mx" styleClass="campo-entrada" />

               </children>

            </VBox>

            <VBox spacing="8.0" maxWidth="300.0">

               <children>

                  <Label fx:id="lblContrasena" styleClass="etiqueta-campo" text="Contraseña:" />

                  <PasswordField fx:id="pfContrasena" promptText="Ingrese contraseña" styleClass="campo-entrada" />

               </children>

            </VBox>

            <Button fx:id="btnIngresar" mnemonicParsing="false" onAction="#leerDatos" styleClass="boton-accion" text="Ingresar" />
            
         </children>
         
         <padding>

            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />

         </padding>
         
      </VBox>
      
   </children>

</VBox>
