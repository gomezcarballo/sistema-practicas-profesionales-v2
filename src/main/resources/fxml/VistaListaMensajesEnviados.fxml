<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="vbRaiz"
      alignment="CENTER"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="20.0"
      styleClass="panel-raiz"
      stylesheets="@../css/estilos.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="spp.presentacion.controladores.mensajeria.ControladorListaMensajesEnviados">

    <children>

        <VBox fx:id="vbTarjetaMensajes"
              alignment="CENTER"
              maxWidth="560.0"
              spacing="20.0"
              styleClass="tarjeta-blanca">

            <children>

                <VBox alignment="CENTER"
                      spacing="5.0">

                    <children>

                        <Label fx:id="lblTituloMensajes"
                               text="Mensajes Enviados"
                               styleClass="etiqueta-titulo"/>

                        <Label fx:id="lblInstruccion"
                               text="Seleccione un mensaje para ver sus detalles"
                               styleClass="etiqueta-instruccion"
                               wrapText="true"/>

                    </children>

                </VBox>

                <TableView fx:id="tblMensajes"
                           prefHeight="250.0"
                           prefWidth="500.0"
                           styleClass="tabla-estandar">

                    <columns>

                        <TableColumn fx:id="colAsunto"
                                     prefWidth="250.0"
                                     text="Asunto"/>

                        <TableColumn fx:id="colCorreoUsuario"
                                     prefWidth="150.0"
                                     text="Remitente"/>

                        <TableColumn fx:id="colFecha"
                                     prefWidth="100.0"
                                     text="Fecha"/>

                    </columns>

                </TableView>

                <BorderPane>

                    <left>
                        <Button fx:id="btnVerMensaje"
                                mnemonicParsing="false"
                                onAction="#verMensaje"
                                text="Ver mensaje"
                                styleClass="boton-accion"
                                BorderPane.alignment="CENTER"/>
                    </left>

                    <right>
                        <Button fx:id="btnRegresar"
                                mnemonicParsing="false"
                                onAction="#regresar"
                                text="Regresar"
                                styleClass="boton-cancelar"
                                BorderPane.alignment="CENTER"/>
                    </right>

                </BorderPane>

            </children>

            <padding>
                <Insets top="30.0"
                        right="30.0"
                        bottom="30.0"
                        left="30.0"/>
            </padding>

        </VBox>

    </children>

</VBox>




