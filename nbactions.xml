<?xml version="1.0" encoding="UTF-8"?>
<actions>

    <!-- RUN -->
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>javafx:run</goal>
        </goals>
    </action>

    <!-- DEBUG -->
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>javafx:run</goal>
        </goals>
        <properties>
            <exec.mainClass>spp.App</exec.mainClass>
        </properties>
    </action>

    <!-- PROFILE (opcional, pero limpio) -->
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>javafx:run</goal>
        </goals>
    </action>

</actions>

